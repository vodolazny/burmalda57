// Theme and global validators / math
import { LightPalette } from "light_palette.slint";

export global Validate {
    pure callback invalid(string) -> bool;
}


export struct ThemePalette {
    primary: color,
    on-primary: color,
    primary-container: color,
    on-primary-container: color,
    secondary-container: color,
    on-secondary-container: color,
    surface: color,
    on-surface: color,
    on-surface-variant: color,
    outline: color,
}

export global Theme {
    // 0 — тёмная, 1 — светлая, 2 — системная.
    in-out property <int> theme-mode: 0;
    in property <bool> system-dark;
    out property <bool> dark: theme-mode == 0 || (theme-mode == 2 && system-dark);

    // -1 — Material You, 0..4 — готовые палитры (4 — монохром).
    in-out property <int> accent-color: has-system-palette ? -1 : 4;
    in property <bool> has-system-palette;
    in-out property <ThemePalette> system-light-palette: root.preset-palette(false, 4);
    in-out property <ThemePalette> system-dark-palette: root.preset-palette(true, 4);
    property <ThemePalette> palette: accent-color == -1 && has-system-palette
        ? (dark ? system-dark-palette : system-light-palette)
        : root.preset-palette(dark, accent-color);

    callback appearance-changed(int, int);
    callback scheme-changed(bool);
    changed dark => { root.scheme-changed(root.dark); }

    public function select-appearance(mode: int, accent: int) {
        if (mode != root.theme-mode || accent != root.accent-color) {
            root.theme-mode = mode;
            root.accent-color = accent;
            root.scheme-changed(root.dark);
            root.appearance-changed(mode, accent);
        }
    }

    public pure function preview-accent(accent: int) -> color {
        return root.preset-palette(false, accent).primary;
    }

    // Межбуквенный интервал: Skia на iOS рисует системный шрифт без трекинга,
    // из-за чего кириллица выглядит слишком плотной. iOS-оболочка ставит 0.3px.
    in-out property <length> tracking: 0px;

    // Высота контента нижней навигации (iOS-оболочка ставит 64px).
    in-out property <length> nav-height: 72px;

    // «Хвост» safe-area под навбаром (iOS-оболочка считает от bottom-inset).
    in-out property <length> nav-bottom-extra: 0px;

    // Active controls are distinct from quiet, secondary tonal containers.
    property <bool> light-monochrome: !dark && (accent-color == 4 || (system-colors && primary == #1C1B1F));
    out property <color> active-container: dark ? secondary-container : (light-monochrome ? #1C1B1F : primary-container);
    out property <color> on-active-container: dark ? on-secondary-container : (light-monochrome ? #FFFFFF : on-primary-container);
    out property <color> warning-container: dark ? #73342F : #FFDAD6;
    out property <color> on-warning-container: dark ? #FFDAD6 : #93000A;

    public pure function is-control-work(kind: string) -> bool {
        return kind.to-lowercase().starts-with("контрольн")
            || kind.to-lowercase() == "кр" || kind.to-lowercase() == "к/р";
    }
    public pure function work-container(kind: string) -> color {
        return root.is-control-work(kind) ? warning-container : secondary-container;
    }
    public pure function on-work-container(kind: string) -> color {
        return root.is-control-work(kind) ? on-warning-container : on-secondary-container;
    }

    out property <color> primary: palette.primary;
    out property <color> on-primary: palette.on-primary;
    out property <color> primary-container: palette.primary-container;
    out property <color> on-primary-container: palette.on-primary-container;
    out property <color> secondary-container: palette.secondary-container;
    out property <color> on-secondary-container: palette.on-secondary-container;
    out property <color> surface: palette.surface;
    out property <color> on-surface: palette.on-surface;
    out property <color> on-surface-variant: palette.on-surface-variant;
    out property <color> outline: palette.outline;

    pure function preset-palette(dark: bool, accent: int) -> ThemePalette {
        if !dark {
            return {
                primary: LightPalette.primary(accent),
                on-primary: #FFFFFF,
                primary-container: LightPalette.primary-container(accent),
                on-primary-container: LightPalette.on-primary-container(accent),
                secondary-container: LightPalette.primary-container(accent),
                on-secondary-container: LightPalette.on-primary-container(accent),
                surface: LightPalette.background(accent),
                on-surface: LightPalette.on-surface(accent),
                on-surface-variant: LightPalette.on-surface-variant(accent),
                outline: #79747E,
            };
        }
        return {
            primary: accent == 1 ? (dark ? #A8C7FA : #0B57D0)
                : accent == 2 ? (dark ? #7ADA91 : #1B6D36)
                : accent == 3 ? (dark ? #FFB77C : #8F4C00)
                : accent == 4 ? (dark ? #E6E1E5 : #1D1B20)
                : (dark ? #D0BCFF : #6750A4),
            on-primary: accent == 1 ? (dark ? #0842A0 : #FFFFFF)
                : accent == 2 ? (dark ? #003915 : #FFFFFF)
                : accent == 3 ? (dark ? #4D2700 : #FFFFFF)
                : accent == 4 ? (dark ? #1D1B20 : #FFFFFF)
                : (dark ? #381E72 : #FFFFFF),
            primary-container: accent == 1 ? (dark ? #0842A0 : #D3E3FD)
                : accent == 2 ? (dark ? #005322 : #95F7AB)
                : accent == 3 ? (dark ? #6E3900 : #FFDCC2)
                : accent == 4 ? (dark ? #333138 : #E2E0E6)
                : (dark ? #4F378B : #EADDFF),
            on-primary-container: accent == 1 ? (dark ? #D3E3FD : #041E49)
                : accent == 2 ? (dark ? #95F7AB : #00210A)
                : accent == 3 ? (dark ? #FFDCC2 : #2E1500)
                : accent == 4 ? (dark ? #E2E0E6 : #1D1B20)
                : (dark ? #EADDFF : #21005D),
            secondary-container: accent == 1 ? (dark ? #004A77 : #C2E7FF)
                : accent == 2 ? (dark ? #2E4E36 : #CCE8D0)
                : accent == 3 ? (dark ? #564032 : #F3DFD1)
                : accent == 4 ? (dark ? #3A383F : #E5E1E6)
                : (dark ? #4A4458 : #E8DEF8),
            on-secondary-container: accent == 1 ? (dark ? #C2E7FF : #001D35)
                : accent == 2 ? (dark ? #CCE8D0 : #0B1F11)
                : accent == 3 ? (dark ? #F3DFD1 : #24160C)
                : accent == 4 ? (dark ? #E5E1E6 : #1D1B20)
                : (dark ? #E8DEF8 : #1D192B),
            surface: accent == 1 ? (dark ? #0F141C : #F0F4FA)
                : accent == 2 ? (dark ? #0E1510 : #F0F6F1)
                : accent == 3 ? (dark ? #18120E : #FAF2EB)
                : accent == 4 ? (dark ? #141414 : #FAFAFA)
                : (dark ? #141218 : #FEF7FF),
            on-surface: accent == 1 ? (dark ? #E1E7F0 : #141B24)
                : accent == 2 ? (dark ? #E0E8E1 : #121D15)
                : accent == 3 ? (dark ? #E8E2DC : #221811)
                : accent == 4 ? (dark ? #E4E4E4 : #1A1A1A)
                : (dark ? #E6E1E5 : #1D1B20),
            on-surface-variant: accent == 1 ? (dark ? #C0C8D4 : #404854)
                : accent == 2 ? (dark ? #BFD0C2 : #3F4A42)
                : accent == 3 ? (dark ? #CFC3B8 : #4E443C)
                : accent == 4 ? (dark ? #C2C2C2 : #4A4A4A)
                : (dark ? #CAC4D0 : #49454F),
            outline: accent == 1 ? (dark ? #8A939F : #707884)
                : accent == 2 ? (dark ? #88968B : #6E7971)
                : accent == 3 ? (dark ? #978C82 : #7D736A)
                : accent == 4 ? (dark ? #888888 : #7A7A7A)
                : (dark ? #938F99 : #79747E),
        };
    }

    // HCT neutral roles supplied by Android; presets keep their own light tones.
    in-out property <color> light-surface-variant: LightPalette.surface-variant(0);
    in-out property <color> light-surface-highest: LightPalette.surface-highest(0);
    in-out property <color> light-outline-variant: LightPalette.outline-variant(0);
    property <bool> system-colors: accent-color == -1 && has-system-palette;

    // ================================================================
    //  Тёмная лестница сохраняет прежний elevation. В светлой теме роли
    //  заданы явно: тонированный фон → белая карточка → вложенная плашка.
    // ================================================================
    out property <color> background:                surface;
    out property <color> surface-card:              dark ? surface-container : LightPalette.surface-card;
    out property <color> surface-variant:           dark ? surface.mix(on-surface, 0.89) : (system-colors ? light-surface-variant : LightPalette.surface-variant(accent-color));
    out property <color> surface-container-low:     dark ? surface.mix(on-surface, 0.96) : LightPalette.surface-card;
    out property <color> surface-container:         dark ? surface.mix(on-surface, 0.93) : LightPalette.surface-card;
    out property <color> surface-container-high:    dark ? surface.mix(on-surface, 0.89) : surface-variant;
    out property <color> surface-container-highest: dark ? surface.mix(on-surface, 0.86) : (system-colors ? light-surface-highest : LightPalette.surface-highest(accent-color));
    out property <color> outline-variant:           dark ? surface.mix(on-surface, 0.72) : (system-colors ? light-outline-variant : LightPalette.outline-variant(accent-color));
    out property <color> nav-bg:                    dark ? surface.mix(on-surface, 0.93) : LightPalette.surface-card;
    out property <color> shadow:             dark ? #00000066 : #0000001F;

    // --- Ошибки (M3 error roles) ---
    out property <color> error:              dark ? #F2B8B5 : #B3261E;
    out property <color> error-container:    dark ? #8C1D18 : #F9DEDC;
    out property <color> on-error-container:  dark ? #F9DEDC : #410E0B;

    // --- Производные ---
    out property <color> primary-2: primary.brighter(0.12);

    // --- Цвета оценок (светлее/пастельнее в тёмной теме — для контраста) ---
    out property <color> mark-5: dark ? #7FD98A : LightPalette.on-success-container;
    out property <color> mark-4: dark ? #7FB2F0 : LightPalette.on-mark-4-container;
    out property <color> mark-3: dark ? #F5B871 : LightPalette.on-mark-3-container;
    out property <color> mark-2: dark ? #F0918C : LightPalette.on-mark-2-container;
    out property <color> success-container: LightPalette.success-container;
    out property <color> mark-4-container: LightPalette.mark-4-container;
    out property <color> mark-3-container: LightPalette.mark-3-container;
    out property <color> mark-2-container: LightPalette.mark-2-container;

    // --- Форма (M3 shape scale, строже) ---
    out property <length> radius-s: 8px;
    out property <length> radius-m: 12px;
    out property <length> radius-l: 12px;
    out property <length> radius-xl: 20px;
}

// ---------------------------------------------------------------------
//  Material Design 3 Expressive: LoadingIndicator (Uncontained)
//  Exact shapes from Material 3 Expressive specification:
//  - Shape A: 12-lobed Soft Scallop Cookie / Sunny Rosette
//  - Shape B: 4-lobed Puffy Pillow / Soft Square Blob
//  - 100% continuous, smooth harmonic morphing + continuous rotation
// ---------------------------------------------------------------------

export global CalMath {
    out property <[string]> months: [
        "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь",
        "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"
    ];
    // Неделя с понедельника
    out property <[string]> weekdays: ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
    // Таблица Сакамото для дня недели
    out property <[int]> sk: [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];

    // Целочисленный остаток (без опоры на встроенный mod)
    pure function imod(a: int, b: int) -> int {
        return a - (a / b).floor() * b;
    }
    pure function is-leap(y: int) -> bool {
        return (root.imod(y, 4) == 0 && root.imod(y, 100) != 0) || root.imod(y, 400) == 0;
    }
    public pure function days-in-month(y: int, m: int) -> int {
        return m == 2 ? (root.is-leap(y) ? 29 : 28)
             : (m == 4 || m == 6 || m == 9 || m == 11) ? 30
             : 31;
    }
    // День недели 1-го числа, 0 = воскресенье (алгоритм Сакамото)
    pure function dow-sun(y: int, m: int, d: int) -> int {
        return root.imod(
            (m < 3 ? y - 1 : y)
            + ((m < 3 ? y - 1 : y) / 4).floor()
            - ((m < 3 ? y - 1 : y) / 100).floor()
            + ((m < 3 ? y - 1 : y) / 400).floor()
            + root.sk[m - 1] + d, 7);
    }
    // День недели 1-го числа, 0 = понедельник ... 6 = воскресенье
    public pure function first-dow-mon(y: int, m: int) -> int {
        return root.imod(root.dow-sun(y, m, 1) + 6, 7);
    }
    // День недели даты: 0 = понедельник ... 6 = воскресенье
    public pure function dow-mon(y: int, m: int, d: int) -> int {
        return root.imod(root.dow-sun(y, m, d) + 6, 7);
    }
    // Сдвиг даты на delta дней (|delta| небольшой, до одного перехода границы месяца).
    // Возвращает код y*10000 + m*100 + d.
    public pure function shift-date(y: int, m: int, d: int, delta: int) -> int {
        return (d + delta) < 1
            ? ((m == 1 ? y - 1 : y) * 10000 + (m == 1 ? 12 : m - 1) * 100
               + (d + delta + root.days-in-month(m == 1 ? y - 1 : y, m == 1 ? 12 : m - 1)))
            : (d + delta) > root.days-in-month(y, m)
                ? ((m == 12 ? y + 1 : y) * 10000 + (m == 12 ? 1 : m + 1) * 100
                   + (d + delta - root.days-in-month(y, m)))
                : (y * 10000 + m * 100 + (d + delta));
    }
    public pure function dec-year(code: int) -> int { return (code / 10000).floor(); }
    public pure function dec-month(code: int) -> int { return root.imod((code / 100).floor(), 100); }
    public pure function dec-day(code: int) -> int { return root.imod(code, 100); }
}


    // Декоративные фоновые волнистые линии (не обрезаются и масштабируются под любой экран)
    Path {
        x: -20px;
        y: 0;
        width: root.width + 40px;
        height: 100%;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 1000; viewbox-height: 1000;
        fit: fill;
        commands: "M 0 300 C 300 150, 650 420, 1000 280";
        fill: transparent;
        stroke: Theme.on-surface-variant.transparentize(0.72);
        stroke-width: 1.5px;
    }
    Path {
        x: -20px;
        y: 0;
        width: root.width + 40px;
        height: 100%;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 1000; viewbox-height: 1000;
        fit: fill;
        commands: "M 0 720 C 350 850, 680 540, 1000 660";
        fill: transparent;
        stroke: Theme.on-surface-variant.transparentize(0.78);
        stroke-width: 1.5px;
    }
    Path {
        x: -20px;
        y: 0;
        width: root.width + 40px;
        height: 100%;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 1000; viewbox-height: 1000;
        fit: fill;
        commands: "M 0 480 C 280 620, 720 320, 1000 460";
        fill: transparent;
        stroke: Theme.primary.transparentize(0.85);
        stroke-width: 1.2px;
    }

    Rectangle {
        width: min(root.width - 48px, 460px);
        height: min(root.height - 32px, root.login-error != "" ? 540px : 440px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: 28px;
        background: Theme.surface-container-low;
        border-width: 1px; border-color: Theme.outline-variant;
        drop-shadow-blur: 32px; drop-shadow-color: Theme.shadow;
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 24px;
        padding-bottom: 28px;
        spacing: 0px;

        // Распор сверху — вместе с нижним центрирует текст
        Rectangle { vertical-stretch: 1; }

        Text {
            text: "Электронный дневник";
            font-size: 30px;
            font-weight: 700;
            color: Theme.on-surface;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Rectangle { height: 10px; }

        Text {
            text: "Войдите через Госуслуги,\nчтобы увидеть оценки и расписание";
            font-size: 15px;
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        // Гибкий распор — блок кнопок уезжает вниз
        Rectangle { vertical-stretch: 1; }

        // Баннер ошибки входа
        if root.login-error != "" : Rectangle {
            height: err.preferred-height + 20px;
            border-radius: Theme.radius-m;
            background: Theme.error-container;
            err := HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 18px; height: 18px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z";
                        fill: Theme.on-error-container;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.login-error;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.on-error-container;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }

        if root.logging-in : HorizontalLayout {
            alignment: center;
            padding-top: 16px;
            Md3LoadingIndicator {
                width: 36px; height: 36px;
            }
        }

        Rectangle { height: 20px; }

        // ------------------------------------------------------------
        //  Большая кнопка входа через Госуслуги
        // ------------------------------------------------------------
        Rectangle {
            height: 60px;
            border-radius: 30px;
            background: login-ta.pressed
                ? Theme.primary.darker(0.12)
                : Theme.primary;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.primary.transparentize(0.65);
            drop-shadow-offset-y: 6px;
            animate background { duration: 120ms; }

            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                padding-left: 20px;
                padding-right: 20px;

                Text {
                    text: root.logging-in ? "Вход…" : "Войти через Госуслуги";
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.on-primary;
                    vertical-alignment: center;
                    overflow: elide;
                    wrap: no-wrap;
                }
                // Стрелка «вперёд»
                if !root.logging-in : VerticalLayout {
                    alignment: center;
                    Path {
                        width: 18px;
                        height: 18px;
                        viewbox-x: 0; viewbox-y: 0;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M 5 12 L 19 12 M 13 6 L 19 12 L 13 18";
                        fill: transparent;
                        stroke: Theme.on-primary;
                        stroke-width: 2px;
                    }
                }
            }

            login-ta := TouchArea {
                clicked => { if (!root.logging-in) { root.login-requested(); } }
            }
        }

        // Незаметная текстовая «Демо» под кнопкой 
        if !root.logging-in : Rectangle {
            height: 44px;
            Text {
                width: 100%;
                height: 100%;
                text: "Демо-режим";
                font-size: 13px;
                font-weight: 500;
                color: demo-ta.pressed
                    ? Theme.on-surface-variant
                    : Theme.on-surface-variant.transparentize(0.35);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            demo-ta := TouchArea {
                clicked => { root.demo-requested(); }
            }
        }
    }
    }
}

// ============================================================
//  M3 Segmented Buttons (одиночный выбор)
// ============================================================
component SegmentedButtons inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback select(int);

    height: 40px;
    border-radius: 20px;
    border-width: 0px;
    border-color: Theme.outline-variant;
    background: Theme.surface-variant;
    clip: true;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for opt[i] in root.options : Rectangle {
            horizontal-stretch: 1;
            border-radius: 16px;
            background: i == root.selected ? Theme.active-container : (seg-ta.pressed ? Theme.on-surface.transparentize(0.92) : transparent);
            animate background { duration: 120ms; }


            Text {
                text: opt;
                font-size: 13px;
                font-weight: i == root.selected ? 700 : 500;
                color: i == root.selected ? Theme.on-active-container : (Theme.dark ? Theme.on-surface : Theme.on-surface-variant);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-ta := TouchArea { clicked => { root.select(i); } }
        }
    }
}

// Шторка создания своего события (выезжает снизу, с затемнением)
component EventSheet inherits Rectangle {
    in property <bool> rail-expanded: false;
    callback save(string, string, string);
    callback close();

    property <bool> valid: name-in.text != "" && start-in.text != ""
        && !Validate.invalid(start-in.text) && !Validate.invalid(end-in.text);

    // Оверлей 100% прозрачный, клик мимо карточки закрывает её
    background: transparent;

    scrim-ta := TouchArea {
        clicked => { root.close(); }
    }

    // Карточка у самого стыка rail'а и рабочей зоны, рядом с кнопкой «+».
    // EventSheet теперь в AppWindow — координаты оконные.
    card := Rectangle {
        x: root.rail-expanded ? 276px : 100px;
        y: 8px;
        width: 380px;
        height: card-col.preferred-height;
        border-radius: 16px;
        background: Theme.dark ? Theme.surface-container-high : Theme.surface-card;
        border-width: 1px;
        border-color: Theme.outline-variant;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.dark ? #000000CC : #00000045;
        drop-shadow-offset-y: 8px;

        inner-ta := TouchArea {
            clicked => { dismiss-fs.focus(); }
        }
        // Невидимый приёмник фокуса — чтобы убрать фокус с поля
        dismiss-fs := FocusScope { width: 0px; height: 0px; }

        card-col := VerticalLayout {
            padding: 18px;
            spacing: 12px;

            // Заголовок + закрыть
            HorizontalLayout {
                spacing: 10px;
                Text {
                    horizontal-stretch: 1;
                    text: "Новое событие";
                    font-size: 17px;
                    font-weight: 800;
                    color: Theme.on-surface;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: close-ta.pressed ? Theme.surface-container-highest : transparent;
                    Path {
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M6 6 L18 18 M6 18 L18 6";
                        fill: transparent;
                        stroke: Theme.on-surface-variant;
                        stroke-width: 2px;
                    }
                    close-ta := TouchArea {
                        clicked => { root.close(); }
                    }
                }
            }

            // Название события
            Text {
                text: "Название";
                font-size: 13px;
                font-weight: 600;
                color: Theme.on-surface-variant;
            }
            Rectangle {
                height: 46px;
                border-radius: Theme.radius-m;
                background: Theme.surface-container-highest;
                name-in := TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 100%;
                    vertical-alignment: center;
                    font-size: 15px;
                    color: Theme.on-surface;
                    single-line: true;
                    accepted => { dismiss-fs.focus(); }
                }
                if name-in.text == "" : Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: 100%;
                    vertical-alignment: center;
                    text: "например, тренировка";
                    font-size: 15px;
                    color: Theme.on-surface-variant.transparentize(0.3);
                }
            }

            // Время начала и конца
            Text {
                text: "Время";
                font-size: 13px;
                font-weight: 600;
                color: Theme.on-surface-variant;
            }
            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 46px;
                    border-radius: Theme.radius-m;
                    background: Theme.surface-container-highest;
                    border-width: Validate.invalid(start-in.text) ? 2px : 0px;
                    border-color: Theme.error;
                    start-in := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 100%;
                        vertical-alignment: center;
                        font-size: 15px;
                        color: Theme.on-surface;
                        single-line: true;
                        accepted => { dismiss-fs.focus(); }
                    }
                    if start-in.text == "" : Text {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 100%;
                        vertical-alignment: center;
                        text: "08:05";
                        font-size: 15px;
                        color: Theme.on-surface-variant.transparentize(0.3);
                    }
                }
                Text {
                    text: "—";
                    font-size: 20px;
                    color: Theme.on-surface-variant;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 46px;
                    border-radius: Theme.radius-m;
                    background: Theme.surface-container-highest;
                    border-width: Validate.invalid(end-in.text) ? 2px : 0px;
                    border-color: Theme.error;
                    end-in := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 100%;
                        vertical-alignment: center;
                        font-size: 15px;
                        color: Theme.on-surface;
                        single-line: true;
                        accepted => { dismiss-fs.focus(); }
                    }
                    if end-in.text == "" : Text {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 100%;
                        vertical-alignment: center;
                        text: "08:45";
                        font-size: 15px;
                        color: Theme.on-surface-variant.transparentize(0.3);
                    }
                }
            }

            // Кнопка «Сохранить»
            Rectangle {
                height: 44px;
                border-radius: 22px;
                background: root.valid
                    ? (save-ta.pressed ? Theme.primary.darker(0.1) : Theme.primary)
                    : Theme.surface-container-highest;
                Text {
                    width: 100%;
                    height: 100%;
                    text: "Сохранить";
                    font-size: 15px;
                    font-weight: 700;
                    color: root.valid ? Theme.on-primary : Theme.on-surface-variant.transparentize(0.4);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                save-ta := TouchArea {
                    clicked => {
                        if (root.valid) {
                            root.save(name-in.text, start-in.text, end-in.text);
                            root.close();
                        }
                    }
                }
            }
        }
    }
}

component DiaryView inherits Rectangle {
    in property <[RecentGrade]> recent-grades;
    in property <string> current-date;
    in property <[Lesson]> lessons;
    in property <string> net-error;
    in property <bool> loading;
    callback prev-day();
    callback next-day();
    callback open-calendar();
    callback refresh();
    // Числовая текущая дата (для выбора дня недели)
    in property <int> cur-year;
    in property <int> cur-month;
    in property <int> cur-day;
    callback pick-date(int, int, int);
    // Свои события пользователя
    callback add-event(string, string, string);
    callback delete-event(string);
    callback toggle-homework(string, bool);
    callback save-note(string, string);
    in-out property <bool> event-open: false;
    background: Theme.background;

    // Лента показывается только при наличии оценок
    property <bool> has-grades: root.recent-grades.length > 0;

    // Десктоп: выбираемый урок и правая панель деталей
    in-out property <int> selected-lesson: -1;
    property <bool> wide: true;
    property <bool> has-selection: root.wide
        && root.selected-lesson >= 0
        && root.selected-lesson < root.lessons.length;

    // Короткая дата для шапки: ДД.ММ
    property <string> dd: root.cur-day < 10 ? "0\{root.cur-day}" : "\{root.cur-day}";
    property <string> mm: root.cur-month < 10 ? "0\{root.cur-month}" : "\{root.cur-month}";
    property <string> date-short: root.cur-day == 0 ? root.current-date : root.dd + "." + root.mm;

    // --- Pull-to-refresh ---
    property <length> pull: 0;          // текущее натяжение (px)
    property <length> pull-trigger: 72px; // порог срабатывания

    // --- Fade при смене дня ---
    property <float> list-fade: 1.0;
    animate list-fade { duration: 150ms; easing: ease-in-out; }
    changed current-date => {
        root.list-fade = 0.25;
        root.selected-lesson = -1;
        // Императивно запускаем таймер: restart() не переопределял
        // константный binding `running: false`, из-за чего таймер не
        // срабатывал и список навсегда оставался затемнён на 25%.
        fade-timer.running = true;
    }
    fade-timer := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.running = false;
            root.list-fade = 1.0;
        }
    }

    VerticalLayout {
        // --- Top App Bar: заголовок страницы + быстрые действия ---
        Rectangle {
            height: 72px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 14px;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Дневник";
                        font-size: 22px;
                        font-weight: 800;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: root.date-short;
                        font-size: 13px;
                        font-weight: 500;
                        color: Theme.on-surface-variant;
                    }
                }

                // Кнопки навигации по дням перенесены к дате
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        RoundIconButton {
                            icon: "M15 6 L9 12 L15 18";
                            clicked => { root.prev-day(); }
                        }
                        RoundIconButton {
                            icon: "M9 6 L15 12 L9 18";
                            clicked => { root.next-day(); }
                        }
                        RoundIconButton {
                            icon: "M7 2 v3 M17 2 v3 M4 5 h16 v16 H4 Z M4 10 h16";
                            clicked => { root.open-calendar(); }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Кнопка обновления остаётся справа
                VerticalLayout {
                    alignment: center;
                    RoundIconButton {
                        icon: "M20 12 a8 8 0 1 1 -2.9 -6.2 M20 4 v4.5 h-4.5";
                        clicked => { root.refresh(); }
                    }
                }
            }
        }

        // --- Выбор дня недели (M3 Segmented Buttons) ---
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: start;
                SegmentedButtons {
                    width: min(parent.width, 560px);
                    options: ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб"];
                    selected: CalMath.dow-mon(root.cur-year, root.cur-month, root.cur-day);
                    select(i) => {
                        root.pick-date(
                            CalMath.dec-year(CalMath.shift-date(root.cur-year, root.cur-month, root.cur-day, i - CalMath.dow-mon(root.cur-year, root.cur-month, root.cur-day))),
                            CalMath.dec-month(CalMath.shift-date(root.cur-year, root.cur-month, root.cur-day, i - CalMath.dow-mon(root.cur-year, root.cur-month, root.cur-day))),
                            CalMath.dec-day(CalMath.shift-date(root.cur-year, root.cur-month, root.cur-day, i - CalMath.dow-mon(root.cur-year, root.cur-month, root.cur-day)))
                        );
                    }
                }
            }
        }

        // --- Баннер ошибки сети (оффлайн / VPN) ---
        if root.net-error != "" : Rectangle {
            height: 56px;
            background: Theme.error-container;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 20px; height: 20px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z";
                        fill: Theme.on-error-container;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.net-error;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.on-error-container;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // --- Лента недавних оценок (статичная, только если есть оценки) ---
        if root.has-grades : Rectangle {
            height: 140px;
            clip: true;

            Flickable {
                x: 0; y: 0;
                width: parent.width; height: 140px;
                content-width: max(parent.width, root.recent-grades.length * 142px + 12px);
                content-height: self.height;

                HorizontalLayout {
                    y: 12px; height: 116px;
                    padding-left: 12px; padding-right: 12px;
                    spacing: 10px;

                    for g in root.recent-grades : RecentGradeCard {
                        subject: g.subject;
                        mark: g.mark;
                        mark-val: g.mark-val;
                        date: g.date;
                    }
                }
            }
        }

        // --- List-Detail: слева расписание дня, справа детали выбранного урока ---
        day-split := HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

        // --- Список уроков / пустое состояние (с pull-to-refresh и fade свайпа) ---
        list-area := Rectangle {
            horizontal-stretch: 1;
            clip: true;

            // Свайп между днями убран — листаем стрелками сверху и выбором дня
            // недели (Segmented Buttons). Так в——ртикальный скролл уроков работа——т
            // без конфликтов жестов.
            flick := Flickable {
                width: 100%;
                height: 100%;
                content-width: flick.width;
                content-height: lessons-col.preferred-height;

                changed content-y => {
                    if (self.content-y > 0px && !root.loading) {
                        root.pull = self.content-y;
                        if (self.content-y >= root.pull-trigger) {
                            root.refresh();
                            root.pull = 0px;
                        }
                    } else {
                        root.pull = 0px;
                    }
                }

                lessons-col := VerticalLayout {
                    width: flick.width;
                    alignment: start;
                    padding-top: 12px;
                    padding-bottom: 12px;

                    // Обертка контента для применения fade-эффекта из DiaryView
                    content-opacity := Rectangle {
                        width: 100%;
                        opacity: root.list-fade; 

                        VerticalLayout {
                            alignment: start;
                            for l[i] in root.lessons : LessonCard {
                                number: l.number;
                                time: l.time;
                                subject: l.subject;
                                room: l.room;
                                homework: l.homework;
                                topic: l.topic;
                                teacher: l.teacher;
                                mark: l.mark;
                                mark-value: l.mark-value;
                                absence: l.absence;
                                grade-type: l.grade-type;
                                is-event: l.is-event;
                                event-id: l.event-id;
                                hw-done: l.hw-done;
                                hw-key: l.hw-key;
                                note: l.note;
                                selectable: root.wide;
                                active: root.wide && i == root.selected-lesson;
                                select => { root.selected-lesson = i; }
                                delete-requested => { root.delete-event(l.event-id); }
                                toggle-homework(k, d) => { root.toggle-homework(k, d); }
                            }
                        }
                    }
                }
            }
            // Индикатор Pull-to-refresh 
            if flick.content-y > 5px && !root.loading : Rectangle {
                property <length> display-pull: min(flick.content-y, 70px);
                y: self.display-pull - 45px;
                height: 40px; width: 40px;
                x: (parent.width - self.width) / 2;
                border-radius: 20px;
                background: Theme.surface-container-high;
                drop-shadow-blur: 6px;
                drop-shadow-color: Theme.shadow;
                opacity: min(flick.content-y / root.pull-trigger, 1.0);
                
                Text {
                    width: 100%;
                    height: 100%;
                    text: flick.content-y >= root.pull-trigger ? "↑" : "——";
                    font-size: 18px;
                    color: Theme.primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.loading : Rectangle {
                y: 16px;
                height: 46px; width: 46px;
                x: (parent.width - self.width) / 2;
                border-radius: 23px;
                background: Theme.surface-container-high;
                drop-shadow-blur: 10px;
                drop-shadow-color: Theme.shadow;
                Md3LoadingIndicator {
                    width: 30px;
                    height: 30px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            // Пустой день
            if root.lessons.length == 0 && root.net-error == "" : VerticalLayout {
                alignment: center;
                spacing: 12px;
                opacity: root.list-fade;
                
                HorizontalLayout {
                    alignment: center;
                    Path {
                        width: 52px; height: 52px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.79 1.42-1.41zM4 10.5H1v2h3v-2zm9-9.95h-2V3.5h2V.55zm7.45 3.91l-1.41-1.41-1.79 1.79 1.41 1.41 1.79-1.79zm-3.21 13.7l1.79 1.8 1.41-1.41-1.8-1.79-1.4 1.4zM20 10.5v2h3v-2h-3zm-8-5c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm-1 4h2v2.95h-2V19.5zm-7.45-.96l1.41 1.41 1.79-1.8-1.41-1.41-1.79 1.8z";
                        fill: Theme.on-surface-variant.transparentize(0.2);
                    }
                }
                Text {
                    text: "В этот день уроков нет";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: center;
                }
            }
        }

        // --- Правая панель: детали выбранного урока (только десктоп) ---
        if root.has-selection : Rectangle {
            width: 380px;
            LessonDetail {
                width: 100%;
                height: 100%;
                lesson: root.lessons[root.selected-lesson];
                toggle-homework(k, d) => { root.toggle-homework(k, d); }
                save-note(k, t) => { root.save-note(k, t); }
            }
        }
        if root.wide && !root.has-selection : Rectangle {
            width: 380px;
            Rectangle {
                x: 12px; y: 5px;
                width: parent.width - 24px;
                height: parent.height - 10px;
                border-radius: Theme.radius-l;
                background: Theme.surface-container-low;
                border-width: 1px;
                border-color: Theme.outline-variant;
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        width: 100%;
                        text: "Выберите урок";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.on-surface;
                        horizontal-alignment: center;
                    }
                    Text {
                        width: 100%;
                        text: "Нажми на урок слева, чтобы увидеть тему,\nдомашнее задание и детали занятия.";
                        font-size: 13px;
                        color: Theme.on-surface-variant;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
        } // /day-split
    }

}

component ProfileView inherits Rectangle {
    in property <string> full-name;
    in property <string> school-name;
    in property <string> school-class;
    in property <string> guid;
    in property <string> sid;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <bool> is-parent: false;
    in property <string> parent-name: "";
    in property <[ChildItem]> children-list;
    in property <bool> demo-only: false;
    callback open-subjects();
    callback logout();
    callback pick-avatar();
    callback open-url(string);
    callback open-child-select();
    background: Theme.background;

    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: min(parent.width - 32px, 700px);
            x: (parent.width - self.width) / 2;
            padding-top: 20px;
            padding-bottom: 40px;
            spacing: 20px;

            // Заголовок раздела
            Text {
                text: "Настройки и профиль";
                font-size: 24px;
                font-weight: 800;
                color: Theme.on-surface;
                horizontal-alignment: left;
            }

            if root.demo-only : Rectangle {
                border-radius: Theme.radius-m;
                background: Theme.secondary-container;
                border-width: 1px;
                border-color: Theme.outline-variant;

                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;

                    Text {
                        text: "Демо-режим";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.on-secondary-container;
                        horizontal-alignment: left;
                    }
                    Text {
                        text: "Это публичная демонстрация на учебных данных: вход и сеть отключены. Полную версию можно собрать из репозитория.";
                        font-size: 12px;
                        color: Theme.on-secondary-container;
                        horizontal-alignment: left;
                        wrap: word-wrap;
                    }
                }
            }

            // ==========================================
            // 1. КАРТОЧКА АККАУНТА (собрана воедино)
            // ==========================================
            Rectangle {
                border-radius: Theme.radius-l;
                background: Theme.surface-container;
                border-width: 1px;
                border-color: Theme.outline-variant;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.shadow;
                drop-shadow-offset-y: 2px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 16px;

                        // Текстовая информация об аккаунте (выровнена к левому краю)
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: root.full-name;
                                font-size: 17px;
                                font-weight: 800;
                                color: Theme.on-surface;
                                horizontal-alignment: left;
                                wrap: word-wrap;
                            }
                            Text {
                                text: (root.school-class != "" ? root.school-class + " класс · " : "") + root.school-name;
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.on-surface-variant;
                                horizontal-alignment: left;
                                wrap: word-wrap;
                            }
                            if root.is-parent && root.parent-name != "" : Text {
                                text: "Родитель: " + root.parent-name;
                                font-size: 12px;
                                color: Theme.on-surface-variant;
                                horizontal-alignment: left;
                            }
                        }

                        // Кнопка «Выйти» (по центру строки по вертикали, не задрана вверх)
                        if !root.demo-only : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 36px;
                                border-radius: 18px;
                                background: logout-ta.pressed
                                    ? Theme.error-container.darker(0.1)
                                    : Theme.error-container.transparentize(0.5);
                                border-width: 1px;
                                border-color: Theme.error.transparentize(0.65);
                                animate background { duration: 120ms; }

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 15px;
                                            height: 15px;
                                            viewbox-width: 24;
                                            viewbox-height: 24;
                                            commands: "M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1";
                                            stroke: Theme.error;
                                            stroke-width: 2px;
                                            fill: transparent;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Выйти";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: Theme.error;
                                            horizontal-alignment: left;
                                        }
                                    }
                                }
                                logout-ta := TouchArea { clicked => { root.logout(); } }
                            }
                        }
                    }

                    // Переключатель ребёнка для родительских аккаунтов
                    if root.is-parent && root.children-list.length > 1 : Rectangle {
                        height: 1px;
                        background: Theme.outline-variant;
                    }
                    if root.is-parent && root.children-list.length > 1 : Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-m;
                        background: child-ta.pressed ? Theme.surface-container-high : Theme.surface-container-low;
                        border-width: 1px;
                        border-color: Theme.outline-variant;
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 18px;
                                    height: 18px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: "M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z";
                                    fill: Theme.primary;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: "Сменить ребёнка (текущий: " + root.full-name + ")";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                    overflow: elide;
                                    horizontal-alignment: left;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 16px;
                                    height: 16px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: "M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z";
                                    fill: Theme.on-surface-variant;
                                }
                            }
                        }
                        child-ta := TouchArea { clicked => { root.open-child-select(); } }
                    }
                }
            }

            Rectangle {
                height: 52px; border-radius: 16px; background: Theme.secondary-container;
                Text { text: "Предметы в дневнике"; font-size: 14px; font-weight: 600; color: Theme.on-secondary-container; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.open-subjects(); } }
            }

            // ==========================================
            // 2. БЛОК «ВНЕШНИЙ ВИД» (Кастомизация M3)
            // ==========================================
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Внешний вид";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: left;
                }

                Rectangle {
                    border-radius: Theme.radius-l;
                    background: Theme.surface-container;
                    border-width: 1px;
                    border-color: Theme.outline-variant;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: Theme.shadow;
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;

                        // Выбор темы оформления
                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Тема оформления";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: MobileTheme.theme-mode == 0 ? "Тёмная тема"
                                        : MobileTheme.theme-mode == 1 ? "Светлая тема"
                                        : "Следовать настройкам системы";
                                    font-size: 12px;
                                    color: Theme.on-surface-variant;
                                    horizontal-alignment: left;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                SegmentedButtons {
                                    width: 280px;
                                    options: ["Тёмная", "Светлая", "Системная"];
                                    selected: MobileTheme.theme-mode;
                                    select(i) => { MobileTheme.select-appearance(i, MobileTheme.accent-color); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.outline-variant; }

                        // Акцентный цвет (сдвинут вправо к боку)
                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: "Акцентный цвет";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                    horizontal-alignment: left;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                AccentPicker {}
                            }
                        }
                    }
                }
            }

            // ==========================================
            // 3. БЛОК «О ПРОГРАММЕ»
            // ==========================================
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "О программе";
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: left;
                }

                Rectangle {
                    border-radius: Theme.radius-l;
                    background: Theme.surface-container;
                    border-width: 1px;
                    border-color: Theme.outline-variant;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: Theme.shadow;
                    drop-shadow-offset-y: 2px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;

                        // Название и стек технологий
                        HorizontalLayout {
                            spacing: 14px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 12px;
                                    background: @linear-gradient(135deg, Theme.primary 0%, Theme.primary-2 100%);

                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            Path {
                                                width: 24px;
                                                height: 24px;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                commands: "M12 3L1 9l11 6 9-4.91V17h2V9L12 3z M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z";
                                                fill: #ffffff;
                                            }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "burmalda57 · v1.0";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: "Стек: WebAssembly · Rust + Slint · Material 3";
                                    font-size: 12px;
                                    color: Theme.on-surface-variant;
                                    horizontal-alignment: left;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.outline-variant; }

                        // Исходный код на GitHub
                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Исходный код на GitHub";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    text: "github.com/vodolazny/burmalda57";
                                    font-size: 12px;
                                    color: Theme.primary;
                                    horizontal-alignment: left;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 36px;
                                    border-radius: 18px;
                                    background: gh-ta.pressed ? Theme.secondary-container.darker(0.08) : Theme.secondary-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 6px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Открыть";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.on-secondary-container;
                                                horizontal-alignment: left;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Path {
                                                width: 14px;
                                                height: 14px;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                commands: "M10 6 L16 12 L10 18";
                                                stroke: Theme.on-secondary-container;
                                                stroke-width: 2px;
                                                fill: transparent;
                                            }
                                        }
                                    }
                                    gh-ta := TouchArea {
                                        clicked => { root.open-url("https://github.com/vodolazny/burmalda57"); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================
//  Вкладка «Оценки»
// ============================================================

// M3 Filter Chip: активный — заливка secondary-container, неактивный — контур
component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    border-radius: 8px;
    background: root.selected
        ? Theme.secondary-container
        : (ta.pressed ? Theme.on-surface.transparentize(0.92) : Theme.surface-container);
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.outline-variant;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}


// Компактная строка предмета для левого списка (list-detail)
component SubjectRow inherits Rectangle {
    in property <string> subject;
    in property <string> average;
    in property <float> average-val;
    in property <int> count;
    in property <bool> active;
    callback select();

    property <int> avg-bucket: root.average-val >= 4.59 ? 5
                             : root.average-val >= 3.59 ? 4
                             : root.average-val >= 2.59 ? 3
                             : root.average-val >  0.0 ? 2
                             : 0;
    height: 64px;
    border-radius: Theme.radius-m;
    background: root.active
        ? Theme.secondary-container
        : (ta.pressed ? Theme.surface-container-high : Theme.surface-container);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.subject;
                font-size: 14px;
                font-weight: 600;
                color: root.active ? Theme.on-secondary-container : Theme.on-surface;
                overflow: elide;
                wrap: no-wrap;
            }
            Text {
                text: root.count > 0 ? "\{root.count} оц." : "нет оценок";
                font-size: 11px;
                color: root.active ? Theme.on-secondary-container : Theme.on-surface-variant;
            }
        }

        am := MarkColor { value: root.avg-bucket; }
        Text {
            text: root.average;
            font-size: 16px;
            font-weight: 800;
            color: root.active ? Theme.on-secondary-container : am.fg;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.select(); } }
}

// Компактная карточка-квадратик для одной оценки в ряд
component GradeSquareCard inherits Rectangle {
    in property <int> value;
    in property <string> date;
    in property <string> work;

    width: 48px;
    height: 52px;
    border-radius: 10px;
    mc := MarkColor { value: root.value; }
    background: Theme.dark
        ? (root.value == 5 ? Theme.mark-5.transparentize(0.86)
            : root.value == 4 ? Theme.mark-4.transparentize(0.86)
            : root.value == 3 ? Theme.mark-3.transparentize(0.86)
            : Theme.mark-2.transparentize(0.86))
        : mc.container;
    border-width: Theme.dark ? 1.5px : 0px;
    border-color: root.value == 5 ? Theme.mark-5.transparentize(0.4)
        : root.value == 4 ? Theme.mark-4.transparentize(0.4)
        : root.value == 3 ? Theme.mark-3.transparentize(0.4)
        : Theme.mark-2.transparentize(0.4);

    VerticalLayout {
        alignment: center;
        spacing: 1px;

        Text {
            text: "\{root.value}";
            font-size: 17px;
            font-weight: 800;
            color: root.value == 5 ? Theme.mark-5
                : root.value == 4 ? Theme.mark-4
                : root.value == 3 ? Theme.mark-3
                : Theme.mark-2;
            horizontal-alignment: center;
        }
        Text {
            text: root.date;
            font-size: 9px;
            font-weight: 600;
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
        }
    }
}

// Компактная стат-карточка: подпись + значение
component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.on-surface;

    height: 64px;
    border-radius: Theme.radius-m;
    background: Theme.surface-container;

    VerticalLayout {
        padding: 12px;
        spacing: 2px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: Theme.on-surface-variant;
        }
        Text {
            text: root.value;
            font-size: 18px;
            font-weight: 800;
            color: root.value-color;
        }
    }
}



// ============================================================
//  Симулятор оценок
// ============================================================
// Степпер оценки: + добавить / − убрать (существующие и виртуальные)
component SimStepper inherits Rectangle {
    in property <int> value;
    in property <int> net;
    in property <bool> can-remove: true;
    callback add();
    callback remove();

    property <color> fg: mc.fg;
    mc := MarkColor { value: root.value; }

    height: 96px;
    border-radius: Theme.radius-m;
    background: Theme.dark ? root.fg.transparentize(0.9) : mc.container;
    border-width: Theme.dark ? 1px : 0px;
    border-color: root.fg.transparentize(0.6);

    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        alignment: center;
        Text {
            text: "\{root.value}";
            font-size: 22px;
            font-weight: 800;
            color: root.fg;
            horizontal-alignment: center;
        }
        Text {
            text: root.net == 0 ? "—" : (root.net > 0 ? "+\{root.net}" : "\{root.net}");
            font-size: 12px;
            font-weight: 700;
            color: root.net == 0 ? Theme.on-surface-variant : root.fg;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                height: 30px;
                border-radius: 8px;
                opacity: root.can-remove ? 1.0 : 0.4;
                background: Theme.surface-container-highest;
                Text {
                    text: "−";
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.on-surface;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                minus-ta := TouchArea {
                    clicked => { root.remove(); }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 30px;
                border-radius: 8px;
                background: root.fg.transparentize(0.8);
                Text {
                    text: "+";
                    font-size: 18px;
                    font-weight: 800;
                    color: root.fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                plus-ta := TouchArea {
                    clicked => { root.add(); }
                }
            }
        }
    }
}

// Панель симулятора «что если» — встроена в правую панель деталей предмета.
// Виртуальные оценки прибавляются к реальным, прогноз пересчитывается live.
component SimPanel inherits Rectangle {
    in property <[DesktopGradeMark]> source-marks;
    in property <float> real-avg;
    in property <int> real-count;
    in property <string> real-avg-str;
    in property <int> n2;
    in property <int> n3;
    in property <int> n4;
    in property <int> n5;
    callback egg();   // пасхалка (67 двоек) — показывает GradesView

    // При смене предмета виртуальные оценки сбрасываются
    changed source-marks => { self.net2 = 0; self.net3 = 0; self.net4 = 0; self.net5 = 0; }

    property <int> net2;
    property <int> net3;
    property <int> net4;
    property <int> net5;

    property <int> change-count: root.net2 + root.net3 + root.net4 + root.net5;
    property <GradeSimulation> projection: GradeMath.project(root.source-marks, root.net2, root.net3, root.net4, root.net5);
    property <int> total-count: root.projection.count;
    property <int> proj-final: root.projection.final-mark;
    property <string> proj-avg-str: root.projection.average-text;

    property <color> proj-color: root.proj-final >= 5 ? Theme.mark-5
        : root.proj-final == 4 ? Theme.mark-4
        : root.proj-final == 3 ? Theme.mark-3
        : root.proj-final > 0 ? Theme.mark-2
        : Theme.on-surface-variant;

    border-radius: Theme.radius-m;
    background: Theme.surface-container-low;
    border-width: 1px;
    border-color: Theme.outline-variant;

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        Text {
            text: "Симулятор «что если»";
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            color: Theme.on-surface-variant;
        }

        // Сейчас → Прогноз
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Сейчас"; font-size: 11px; font-weight: 600; color: Theme.on-surface-variant; horizontal-alignment: center; }
                Text {
                    text: root.real-count == 0 ? "—" : root.real-avg-str;
                    font-size: 24px;
                    font-weight: 800;
                    color: Theme.on-surface;
                    horizontal-alignment: center;
                }
                Text { text: "\{root.real-count} оц."; font-size: 11px; color: Theme.on-surface-variant; horizontal-alignment: center; }
            }
            VerticalLayout {
                alignment: center;
                Path {
                    width: 20px; height: 20px;
                    viewbox-width: 24; viewbox-height: 24;
                    commands: "M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z";
                    fill: Theme.on-surface-variant;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Прогноз"; font-size: 11px; font-weight: 600; color: Theme.on-surface-variant; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: root.proj-avg-str;
                        font-size: 24px;
                        font-weight: 800;
                        color: root.proj-color;
                        vertical-alignment: center;
                    }
                    if root.proj-final > 0 : MarkToken {
                        text: "\{root.proj-final}";
                        value: root.proj-final;
                        size: 36px;
                        font: 18px;
                    }
                }
                Text { text: root.change-count == 0 ? "\{root.total-count} оц." : (root.change-count > 0 ? "\{root.total-count} оц. (+\{root.change-count})" : "\{root.total-count} оц. (\{root.change-count})"); font-size: 11px; color: Theme.on-surface-variant; horizontal-alignment: center; }
            }
        }

        // Степперы виртуальных оценок
        HorizontalLayout {
            spacing: 8px;
            SimStepper { horizontal-stretch: 1; value: 5; net: root.net5; can-remove: root.net5 > -root.n5; add => { root.net5 += 1; } remove => { root.net5 -= root.net5 > -root.n5 ? 1 : 0; } }
            SimStepper { horizontal-stretch: 1; value: 4; net: root.net4; can-remove: root.net4 > -root.n4; add => { root.net4 += 1; } remove => { root.net4 -= root.net4 > -root.n4 ? 1 : 0; } }
            SimStepper { horizontal-stretch: 1; value: 3; net: root.net3; can-remove: root.net3 > -root.n3; add => { root.net3 += 1; } remove => { root.net3 -= root.net3 > -root.n3 ? 1 : 0; } }
            SimStepper { horizontal-stretch: 1; value: 2; net: root.net2; can-remove: root.net2 > -root.n2; add => { root.net2 += 1; if root.net2 == 67 { root.egg(); } } remove => { root.net2 -= root.net2 > -root.n2 ? 1 : 0; } }
        }

        Rectangle {
            height: 40px;
            border-radius: 20px;
            background: reset-ta.pressed ? Theme.surface-container-highest : Theme.surface-container-high;
            Text {
                text: "Сбросить";
                font-size: 13px;
                font-weight: 700;
                color: root.change-count != 0 ? Theme.primary : Theme.on-surface-variant;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            reset-ta := TouchArea {
                clicked => { root.net2 = 0; root.net3 = 0; root.net4 = 0; root.net5 = 0; }
            }
        }

        Text {
            text: "Это прикидка: как изменится средний балл, если добавить или убрать оценки. Реальные оценки не меняются.";
            font-size: 11px;
            color: Theme.on-surface-variant;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// Область графика динамики оценок за год (переиспользуется в панели деталей).
// Точки — нормализованные координаты 0..1, линия рисуется по сегментам.
component ChartPlot inherits Rectangle {
    in property <[ChartPoint]> points;
    in property <[ChartDivider]> dividers;
    in property <bool> has-data;
    in property <bool> loading;

    border-radius: Theme.radius-l;
    background: Theme.surface-container-high;
    clip: true;

    // Внутренние отступы области рисования
    property <length> pad-l: 30px;
    property <length> pad-r: 14px;
    property <length> pad-t: 14px;
    property <length> pad-b: 14px;
    property <length> plot-w: self.width - self.pad-l - self.pad-r;
    property <length> plot-h: self.height - self.pad-t - self.pad-b;
    // Доля отступа сверху/снизу (в нормированных координатах), чтобы линия
    // у оценок 5 и 2 не прижималась к краю и не обрезалась.
    property <float> pad-frac: 0.12;

    // Горизонтальные линии-уровни 2..5 + подписи слева
    for lvl[i] in [5, 4, 3, 2] : Rectangle {
        property <float> yy: (5 - lvl) / 3.0;
        x: root.pad-l;
        y: root.pad-t + root.plot-h * (root.pad-frac + self.yy * (1 - 2 * root.pad-frac));
        width: root.plot-w;
        height: 1px;
        background: Theme.on-surface-variant.transparentize(0.9);
        Text {
            x: -22px;
            y: -8px;
            text: "\{lvl}";
            font-size: 11px;
            color: Theme.on-surface-variant;
        }
    }

    // Пунктирные границы четвертей + подписи
    for d in root.dividers : Rectangle {
        x: root.pad-l + root.plot-w * d.px;
        y: root.pad-t;
        width: 1px;
        height: root.plot-h;
        background: transparent;
        for k in 14 : Rectangle {
            x: 0;
            y: k * (parent.height / 14) + 2px;
            width: 1px;
            height: (parent.height / 14) - 4px;
            background: Theme.outline;
        }
        Text {
            x: 3px;
            y: parent.height - self.height - 2px;
            text: d.label;
            font-size: 9px;
            color: Theme.on-surface-variant;
        }
    }

    // Линия графика: по сегментам между соседними точками, viewbox = размер
    // элемента в пикселях, чтобы линия не сжималась квадратным viewbox.
    for p[i] in root.points : Path {
        x: root.pad-l;
        y: root.pad-t;
        width: root.plot-w;
        height: root.plot-h;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.plot-w / 1px;
        viewbox-height: root.plot-h / 1px;
        property <float> x1: root.plot-w / 1px * p.px;
        property <float> y1: root.plot-h / 1px * (root.pad-frac + p.py * (1 - 2 * root.pad-frac));
        property <float> x2: i < root.points.length - 1 ? root.plot-w / 1px * root.points[i + 1].px : x1;
        property <float> y2: i < root.points.length - 1 ? root.plot-h / 1px * (root.pad-frac + root.points[i + 1].py * (1 - 2 * root.pad-frac)) : y1;
        commands: i < root.points.length - 1 ? "M \{x1} \{y1} L \{x2} \{y2}" : "";
        fill: transparent;
        stroke: Theme.primary;
        stroke-width: 2.5px;
    }

    // Точки-маркеры оценок поверх линии
    for p in root.points : Rectangle {
        mc := MarkColor { value: p.value; }
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        x: root.pad-l + root.plot-w * p.px - self.width / 2;
        y: root.pad-t + root.plot-h * (root.pad-frac + p.py * (1 - 2 * root.pad-frac)) - self.height / 2;
        background: mc.fg;
        border-width: 2px;
        border-color: Theme.surface-container-high;
    }

    if root.loading : Md3LoadingIndicator {
        width: 42px; height: 42px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if !root.loading && !root.has-data : Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: "Нет оценок для графика";
        font-size: 14px;
        color: Theme.on-surface-variant;
    }
}

component GradesView inherits Rectangle {
    in property <[string]> periods;
    in property <int> selected;
    in property <[DesktopSubjectGrades]> subjects;
    in property <[SubjectFinals]> finals;
    in property <int> mode;          // 0 — текущая, 1 — годовая
    in property <bool> loading;
    in property <string> error;
    callback select(int);
    callback select-mode(int);
    background: Theme.background;

    // Локальный режим: переключается мгновенно по тапу, а Rust уведомляется
    // через select-mode() для ленивой загрузки годовых. Инициализируется из
    // входного mode; после первого тапа управление берёт UI.
    property <int> active-mode: root.mode;
    changed mode => { root.active-mode = root.mode; }

    // --- Выбранный предмет (List-Detail) ---
    in-out property <int> selected-subject: 0;
    property <bool> has-sel: root.active-mode == 0 && root.subjects.length > 0
        && root.selected-subject >= 0 && root.selected-subject < root.subjects.length;
    property <string> sel-subject: root.has-sel ? root.subjects[root.selected-subject].subject : "";
    property <string> sel-avg-str: root.has-sel ? root.subjects[root.selected-subject].average : "—";
    property <float> sel-avg: root.has-sel ? root.subjects[root.selected-subject].average-val : 0.0;
    property <int> sel-count: root.has-sel ? root.subjects[root.selected-subject].marks.length : 0;
    property <int> sel-n5: root.has-sel ? root.subjects[root.selected-subject].n5 : 0;
    property <int> sel-n4: root.has-sel ? root.subjects[root.selected-subject].n4 : 0;
    property <int> sel-n3: root.has-sel ? root.subjects[root.selected-subject].n3 : 0;
    property <int> sel-n2: root.has-sel ? root.subjects[root.selected-subject].n2 : 0;
    property <[DesktopGradeMark]> sel-marks: root.has-sel ? root.subjects[root.selected-subject].marks : no-marks;
    property <[DesktopGradeMark]> no-marks;
    property <int> dist-total: root.sel-n5 + root.sel-n4 + root.sel-n3 + root.sel-n2;

    // Прогноз четвертной оценки: тот же алгоритм, что в симуляторе
    property <GradeSimulation> original: GradeMath.project(root.sel-marks, 0, 0, 0, 0);
    property <int> sel-proj: root.original.final-mark;
    property <color> sel-proj-color: root.sel-proj >= 5 ? Theme.mark-5
        : root.sel-proj == 4 ? Theme.mark-4
        : root.sel-proj == 3 ? Theme.mark-3
        : root.sel-proj > 0 ? Theme.mark-2
        : Theme.on-surface-variant;
    // Сколько пятёрок подряд нужно до среднего 4.60 (порог «пятёрки»)
    property <int> gap5: root.original.fives-needed;

    pure function format-col(l: string) -> string {
        return l == "1" ? "1 чт"
             : l == "2" ? "2 чт"
             : l == "3" ? "3 чт"
             : l == "4" ? "4 чт"
             : (l == "Год" || l == "год" || l == "Итог" || l == "Итоговая") ? "Итог"
             : l;
    }

    // График успеваемости за год (загружается Rust'ом для выбранного предмета)
    in property <[ChartPoint]> chart-points;
    in property <[ChartDivider]> chart-dividers;
    in property <string> chart-line-path;
    in property <bool> chart-has-data;
    in property <bool> chart-loading;
    property <string> chart-subject;
    callback open-chart(string);   // Rust грузит годовые оценки предмета

    // При смене предмета / списка — сброс выбора и перезагрузка графика
    changed subjects => {
        root.selected-subject = 0;
        if (root.active-mode == 0 && root.subjects.length > 0) {
            root.chart-subject = root.subjects[0].subject;
            root.open-chart(root.chart-subject);
        }
    }
    changed selected-subject => {
        if (root.has-sel) {
            root.chart-subject = root.subjects[root.selected-subject].subject;
            root.open-chart(root.chart-subject);
        }
    }
    // При монтировании вкладки сразу грузим график выбранного предмета
    init => {
        if (root.subjects.length > 0) {
            root.chart-subject = root.subjects[0].subject;
            root.open-chart(root.chart-subject);
        }
    }

    VerticalLayout {
        // --- Top App Bar: заголовок + переключатель режима ---
        Rectangle {
            height: 72px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;

                Text {
                    text: "Успеваемость";
                    font-size: 22px;
                    font-weight: 800;
                    color: Theme.on-surface;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    SegmentedButtons {
                        width: 240px;
                        options: ["Текущая", "Годовая"];
                        selected: root.active-mode;
                        select(i) => { root.active-mode = i; root.select-mode(i); }
                    }
                }
            }
        }

        // ================= ТЕКУЩАЯ (List-Detail) =================
        if root.active-mode == 0 : VerticalLayout {
            vertical-stretch: 1;

            // Чипсы четвертей (фильтры периода)
            Rectangle {
                height: 54px;
                clip: true;
                Flickable {
                    width: 100%;
                    height: 100%;
                    content-width: max(self.width, chips.preferred-width);
                    content-height: self.height;
                    chips := HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 11px;
                        spacing: 8px;
                        alignment: start;
                        for p[i] in root.periods : FilterChip {
                            text: p;
                            selected: i == root.selected;
                            clicked => { root.select(i); }
                        }
                    }
                }
            }

            // Список предметов (слева) + панель аналитики (справа)
            Rectangle {
                vertical-stretch: 1;
            HorizontalLayout {
                spacing: 0px;

                // Левая колонка: список предметов
                Rectangle {
                    width: 360px;
                    clip: true;
                    Flickable {
                        width: 100%;
                        height: 100%;
                        content-width: self.width;
                        content-height: scol.preferred-height;
                        scol := VerticalLayout {
                            width: parent.width;
                            padding-left: 20px;
                            padding-right: 12px;
                            padding-top: 4px;
                            padding-bottom: 16px;
                            spacing: 8px;
                            alignment: start;
                            for s[i] in root.subjects : SubjectRow {
                                subject: s.subject;
                                average: s.average;
                                average-val: s.average-val;
                                count: s.marks.length;
                                active: i == root.selected-subject;
                                select => { root.selected-subject = i; }
                            }
                        }
                    }
                }

                // Разделитель панелей
                Rectangle {
                    width: 1px;
                    background: Theme.outline-variant;
                }

                // Правая панель: аналитика выбранного предмета
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    if root.has-sel : Flickable {
                        width: 100%;
                        height: 100%;
                        content-width: self.width;
                        content-height: dcol.preferred-height;
                        dcol := VerticalLayout {
                            width: parent.width;
                            padding: 20px;
                            padding-top: 4px;
                            spacing: 16px;
                            alignment: start;

                            // Заголовок + прогноз-бейдж
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: root.sel-subject;
                                        font-size: 22px;
                                        font-weight: 800;
                                        color: Theme.on-surface;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                    Text {
                                        text: root.sel-count > 0
                                            ? "Средний балл: \{root.sel-avg-str} — \{root.sel-count} оц."
                                            : "Оценок пока нет";
                                        font-size: 13px;
                                        color: Theme.on-surface-variant;
                                    }
                                }
                                if root.sel-count > 0 : VerticalLayout {
                                    alignment: center;
                                    MarkToken {
                                        text: "\{root.sel-proj}";
                                        value: root.sel-proj;
                                        size: 48px;
                                        font: 23px;
                                    }
                                }
                            }

                            // Стат-карточки: средний / прогноз
                            HorizontalLayout {
                                spacing: 12px;
                                StatCard {
                                    horizontal-stretch: 1;
                                    label: "Средний";
                                    value: root.sel-avg-str;
                                }
                                StatCard {
                                    horizontal-stretch: 1;
                                    label: "Прогноз за четверть";
                                    value: root.sel-count > 0 ? "\{root.sel-proj}" : "—";
                                    value-color: root.sel-proj-color;
                                }
                            }

                            // Все оценки (карточками-квадратиками в ряд)
                            if root.sel-count > 0 : VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Все оценки (" + root.sel-count + ")";
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Theme.on-surface-variant;
                                }
                                Rectangle {
                                    height: 54px;
                                    Flickable {
                                        width: 100%;
                                        height: 100%;
                                        content-width: max(self.width, marks-flow.preferred-width);
                                        content-height: self.height;

                                        marks-flow := HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;

                                            for m in root.sel-marks : GradeSquareCard {
                                                value: m.value;
                                                date: m.date;
                                                work: m.work;
                                            }
                                        }
                                    }
                                }
                            }

                            // График динамики оценок за год
                            Text {
                                text: "Динамика оценок за год";
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                color: Theme.on-surface-variant;
                            }
                            ChartPlot {
                                height: 260px;
                                points: root.chart-points;
                                dividers: root.chart-dividers;
                                has-data: root.chart-has-data;
                                loading: root.chart-loading;
                            }

                            if root.sel-count > 0 : SimPanel {
                                source-marks: root.sel-marks;
                                real-avg: root.sel-avg;
                                real-count: root.sel-count;
                                real-avg-str: root.sel-avg-str;
                                n2: root.sel-n2;
                                n3: root.sel-n3;
                                n4: root.sel-n4;
                                n5: root.sel-n5;
                                egg => { root.egg-open = true; }
                            }

                            // Распределение оценок
                            if root.sel-count > 0 : Text {
                                text: "Распределение оценок";
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                color: Theme.on-surface-variant;
                            }
                            if root.sel-count > 0 : Rectangle {
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.surface-container-highest;
                                clip: true;
                                HorizontalLayout {
                                    spacing: 2px;
                                    if root.sel-n5 > 0 : Rectangle {
                                        width: parent.width * root.sel-n5 / max(root.dist-total, 1);
                                        background: Theme.mark-5;
                                    }
                                    if root.sel-n4 > 0 : Rectangle {
                                        width: parent.width * root.sel-n4 / max(root.dist-total, 1);
                                        background: Theme.mark-4;
                                    }
                                    if root.sel-n3 > 0 : Rectangle {
                                        width: parent.width * root.sel-n3 / max(root.dist-total, 1);
                                        background: Theme.mark-3;
                                    }
                                    if root.sel-n2 > 0 : Rectangle {
                                        width: parent.width * root.sel-n2 / max(root.dist-total, 1);
                                        background: Theme.mark-2;
                                    }
                                }
                            }
                            if root.sel-count > 0 : HorizontalLayout {
                                spacing: 16px;
                                Text { text: "5 — \{root.sel-n5} шт."; font-size: 12px; font-weight: 600; color: Theme.mark-5; }
                                Text { text: "4 — \{root.sel-n4} шт."; font-size: 12px; font-weight: 600; color: Theme.mark-4; }
                                Text { text: "3 — \{root.sel-n3} шт."; font-size: 12px; font-weight: 600; color: Theme.mark-3; }
                                Text { text: "2 — \{root.sel-n2} шт."; font-size: 12px; font-weight: 600; color: Theme.mark-2; }
                            }
                        }
                    }

                    // Пустое состояние правой панели
                    if !root.has-sel : VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        Text {
                            text: "Выбери предмет";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.on-surface;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Слева — список предметов, здесь появится аналитика:\nдинамика, симулятор, распределение и история оценок.";
                            font-size: 13px;
                            color: Theme.on-surface-variant;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Загрузка / ошибка / пусто — поверх всей области
            if root.loading && root.subjects.length == 0 : Md3LoadingIndicator {
                width: 46px; height: 46px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if !root.loading && root.subjects.length == 0 : VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Path {
                        width: 52px; height: 52px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: root.error != ""
                            ? "M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                            : "M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-5h2v5zm4 0h-2v-8h2v8zm4 0h-2v-3h2v3z";
                        fill: root.error != "" ? Theme.error : Theme.on-surface-variant.transparentize(0.3);
                    }
                }
                Text {
                    text: root.error != "" ? root.error : "За эту четверть оценок нет";
                    font-size: 14px; font-weight: 500;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: center; wrap: word-wrap;
                }
            }
            }
        }

        // ================= ГОДОВАЯ (компактная таблица M3 Data Table) =================
        if root.active-mode == 1 : Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Центрированная таблица по канонам M3: Предмет | 1 чт | 2 чт | 3 чт | 4 чт | Итог
            if root.finals.length > 0 : VerticalLayout {
                alignment: start;
                padding-top: 16px;
                padding-bottom: 20px;
                padding-left: 20px;
                padding-right: 20px;

                Rectangle {
                    width: min(parent.width - 40px, 860px);
                    max-height: parent.height - 40px;
                    border-radius: Theme.radius-m;
                    background: Theme.surface-container;
                    border-width: 1px;
                    border-color: Theme.outline-variant;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: Theme.shadow;
                    drop-shadow-offset-y: 3px;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        // Шапка таблицы (M3 Data Table Header)
                        Rectangle {
                            height: 48px;
                            background: Theme.surface-container-high;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 16px;
                                spacing: 8px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: "Предмет";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.on-surface-variant;
                                    vertical-alignment: center;
                                }
                                for m[j] in root.finals[0].marks : Text {
                                    width: j == root.finals[0].marks.length - 1 ? 72px : 64px;
                                    text: root.format-col(m.label);
                                    font-size: 13px;
                                    font-weight: j == root.finals[0].marks.length - 1 ? 800 : 700;
                                    color: j == root.finals[0].marks.length - 1 ? Theme.primary : Theme.on-surface-variant;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.outline-variant; }

                        // Тело таблицы со скроллом
                        Flickable {
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: table-body.preferred-height;

                            table-body := VerticalLayout {
                                alignment: start;
                                spacing: 0px;

                                for row[i] in root.finals : VerticalLayout {
                                    alignment: start;
                                    spacing: 0px;

                                    Rectangle {
                                        height: 46px;
                                        background: row-ta.has-hover ? Theme.surface-container-highest
                                                  : (Math.mod(i, 2) == 1 ? Theme.surface-container-low : transparent);

                                        HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            Text {
                                                horizontal-stretch: 1;
                                                text: row.subject;
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: Theme.on-surface;
                                                overflow: elide;
                                                wrap: no-wrap;
                                                vertical-alignment: center;
                                            }

                                            for m[j] in row.marks : Rectangle {
                                                width: j == row.marks.length - 1 ? 72px : 64px;
                                                mc := MarkColor {
                                                    value: m.average-val >= 4.59 ? 5
                                                         : m.average-val >= 3.59 ? 4
                                                         : m.average-val >= 2.59 ? 3
                                                         : m.average-val > 0.0 ? 2
                                                         : 0;
                                                }

                                                // Акцентная плашка для итоговой оценки
                                                if j == row.marks.length - 1 && m.average != "—" && m.average != "" : Rectangle {
                                                    width: 36px;
                                                    height: 28px;
                                                    border-radius: 8px;
                                                    background: Theme.dark ? mc.fg.transparentize(0.85) : mc.container;
                                                    border-width: Theme.dark ? 1px : 0px;
                                                    border-color: mc.fg.transparentize(0.65);
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                Text {
                                                    text: m.average;
                                                    font-size: j == row.marks.length - 1 ? 15px : 14px;
                                                    font-weight: j == row.marks.length - 1 ? 800 : 700;
                                                    color: m.average == "—" ? Theme.on-surface-variant.transparentize(0.4) : mc.fg;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        row-ta := TouchArea { }
                                    }

                                    if i < root.finals.length - 1 : Rectangle {
                                        height: 1px;
                                        background: Theme.outline-variant.transparentize(0.5);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if root.loading && root.finals.length == 0 : Md3LoadingIndicator {
                width: 46px; height: 46px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if !root.loading && root.finals.length == 0 : VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Path {
                        width: 52px; height: 52px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: root.error != ""
                            ? "M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                            : "M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-5h2v5zm4 0h-2v-8h2v8zm4 0h-2v-3h2v3z";
                        fill: root.error != "" ? Theme.error : Theme.on-surface-variant.transparentize(0.3);
                    }
                }
                Text {
                    text: root.error != "" ? root.error : "Итоговых оценок пока нет";
                    font-size: 14px; font-weight: 500;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: center; wrap: word-wrap;
                }
            }
        }
    }

    // Пасхалка: 67 виртуальных двоек в симуляторе
    property <bool> egg-open: false;
    if root.egg-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.transparentize(0.25);

        TouchArea {
            clicked => { root.egg-open = false; }
        }

        VerticalLayout {
            alignment: center;
            padding: 20px;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: min(parent.width - 40px, 360px);
                    border-radius: Theme.radius-xl;
                    background: Theme.surface-container;
                    border-width: 1px;
                    border-color: Theme.outline-variant;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #000000.transparentize(0.5);
                    clip: true;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;

                            Image {
                                source: @image-url("../assets/image.png");
                                width: min(parent.width, 300px);
                                height: 250px;
                                image-fit: contain;
                            }
                        }

                        Rectangle {
                            width: 100%;
                            height: 44px;
                            border-radius: 22px;
                            background: Theme.primary;

                            Text {
                                text: "Че?!?!";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.on-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.egg-open = false; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================
//  Календарные вычисления (чистая арифметика, без локали)
// ============================================================
global CalMath {
    out property <[string]> months: [
        "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь",
        "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"
    ];
    // Неделя с понедельника
    out property <[string]> weekdays: ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
    // Таблица Сакамото для дня недели
    out property <[int]> sk: [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];

    // Целочисленный остаток (без опоры на встроенный mod)
    pure function imod(a: int, b: int) -> int {
        return a - (a / b).floor() * b;
    }
    pure function is-leap(y: int) -> bool {
        return (root.imod(y, 4) == 0 && root.imod(y, 100) != 0) || root.imod(y, 400) == 0;
    }
    public pure function days-in-month(y: int, m: int) -> int {
        return m == 2 ? (root.is-leap(y) ? 29 : 28)
             : (m == 4 || m == 6 || m == 9 || m == 11) ? 30
             : 31;
    }
    // День недели 1-го числа, 0 = воскресенье (алгоритм Сакамото)
    pure function dow-sun(y: int, m: int, d: int) -> int {
        return root.imod(
            (m < 3 ? y - 1 : y)
            + ((m < 3 ? y - 1 : y) / 4).floor()
            - ((m < 3 ? y - 1 : y) / 100).floor()
            + ((m < 3 ? y - 1 : y) / 400).floor()
            + root.sk[m - 1] + d, 7);
    }
    // День недели 1-го числа, 0 = понедельник ... 6 = воскресенье
    public pure function first-dow-mon(y: int, m: int) -> int {
        return root.imod(root.dow-sun(y, m, 1) + 6, 7);
    }
    // День недели даты: 0 = понедельник ... 6 = воскресенье
    public pure function dow-mon(y: int, m: int, d: int) -> int {
        return root.imod(root.dow-sun(y, m, d) + 6, 7);
    }
    // Сдвиг даты на delta дней (|delta| небольшой, до одного перехода границы месяца).
    // Возвращает код y*10000 + m*100 + d.
    public pure function shift-date(y: int, m: int, d: int, delta: int) -> int {
        return (d + delta) < 1
            ? ((m == 1 ? y - 1 : y) * 10000 + (m == 1 ? 12 : m - 1) * 100
               + (d + delta + root.days-in-month(m == 1 ? y - 1 : y, m == 1 ? 12 : m - 1)))
            : (d + delta) > root.days-in-month(y, m)
                ? ((m == 12 ? y + 1 : y) * 10000 + (m == 12 ? 1 : m + 1) * 100
                   + (d + delta - root.days-in-month(y, m)))
                : (y * 10000 + m * 100 + (d + delta));
    }
    public pure function dec-year(code: int) -> int { return (code / 10000).floor(); }
    public pure function dec-month(code: int) -> int { return root.imod((code / 100).floor(), 100); }
    public pure function dec-day(code: int) -> int { return root.imod(code, 100); }
}

// ============================================================
//  календарь выбора даты (год, месяц, день)
// ============================================================
component RuCalendar inherits Rectangle {
    in property <int> init-year;
    in property <int> init-month;
    in property <int> init-day;
    callback accepted(int, int, int);   // год, месяц, день
    callback canceled();

    property <int> view-year: root.init-year;
    property <int> view-month: root.init-month;
    property <int> first-dow: CalMath.first-dow-mon(root.view-year, root.view-month);
    property <int> days: CalMath.days-in-month(root.view-year, root.view-month);

    // Затемняющий фон
    background: #00000066;
    // Тап вне карточки — отмена
    TouchArea { clicked => { root.canceled(); } }

    // Карточка календаря
    Rectangle {
        width: min(parent.width - 48px, 360px);
        height: 456px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xl;
        background: Theme.dark ? Theme.surface-container-high : Theme.surface-card;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 8px;

        // Блокируем «протекание» тапов на фон
        TouchArea {}

        // Свайп влево/вправо — смена месяца; тапы по дням проходят к детям
        month-swipe := SwipeGestureHandler {
            width: 100%;
            height: 100%;
            handle-swipe-left: true;
            handle-swipe-right: true;
            swiped => {
                if (self.current-position.x < self.pressed-position.x) {
                    // следующий месяц
                    if (root.view-month == 12) { root.view-month = 1; root.view-year += 1; }
                    else { root.view-month += 1; }
                } else {
                    // предыдущий месяц
                    if (root.view-month == 1) { root.view-month = 12; root.view-year -= 1; }
                    else { root.view-month -= 1; }
                }
            }

        VerticalLayout {
            padding: 16px;
            spacing: 6px;

            // --- Заголовок: — Месяц Год — ---
            HorizontalLayout {
                height: 44px;
                spacing: 4px;

                Rectangle {
                    width: 40px; height: 40px; border-radius: 20px;
                    background: pm.pressed ? Theme.secondary-container : transparent;
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Path {
                                width: 20px; height: 20px;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: "M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z";
                                fill: Theme.on-surface;
                            }
                        }
                    }
                    pm := TouchArea { clicked => {
                        if (root.view-month == 1) { root.view-month = 12; root.view-year -= 1; }
                        else { root.view-month -= 1; }
                    } }
                }

                Text {
                    horizontal-stretch: 1;
                    text: "\{CalMath.months[root.view-month - 1]} \{root.view-year}";
                    font-size: 18px; font-weight: 700; color: Theme.on-surface;
                    horizontal-alignment: center; vertical-alignment: center;
                }

                Rectangle {
                    width: 40px; height: 40px; border-radius: 20px;
                    background: nm.pressed ? Theme.secondary-container : transparent;
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Path {
                                width: 20px; height: 20px;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: "M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z";
                                fill: Theme.on-surface;
                            }
                        }
                    }
                    nm := TouchArea { clicked => {
                        if (root.view-month == 12) { root.view-month = 1; root.view-year += 1; }
                        else { root.view-month += 1; }
                    } }
                }
            }

            // --- Шапка дней недели (Пн ... Вс) ---
            HorizontalLayout {
                height: 30px;
                for wd[idx] in CalMath.weekdays : Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: wd;
                        font-size: 12px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                        color: idx >= 5 ? Theme.mark-2 : Theme.on-surface-variant;
                    }
                }
            }

            // --- Сетка 6—7 --- сикссевен
            for row in 6 : HorizontalLayout {
                height: 44px;
                for col in 7 : cell := Rectangle {
                    horizontal-stretch: 1;
                    property <int> daynum: row * 7 + col - root.first-dow + 1;
                    property <bool> valid: cell.daynum >= 1 && cell.daynum <= root.days;
                    property <bool> is-sel: cell.valid
                        && cell.daynum == root.init-day
                        && root.view-month == root.init-month
                        && root.view-year == root.init-year;
                    property <bool> weekend: col >= 5;

                    Rectangle {
                        width: 40px; height: 40px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 20px;
                        background: cell.is-sel ? Theme.primary
                                  : (ta.pressed && cell.valid) ? Theme.secondary-container
                                  : transparent;
                        Text {
                            width: 100%; height: 100%;
                            text: cell.valid ? "\{cell.daynum}" : "";
                            font-size: 15px;
                            font-weight: cell.is-sel ? 700 : 500;
                            color: cell.is-sel ? Theme.on-primary
                                 : cell.weekend ? Theme.mark-2
                                 : Theme.on-surface;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    ta := TouchArea {
                        clicked => {
                            if (cell.valid) { root.accepted(root.view-year, root.view-month, cell.daynum); }
                        }
                    }
                }
            }

            // --- Нижняя строка действий ---
            HorizontalLayout {
                height: 44px;
                alignment: end;
                Rectangle {
                    width: 108px; height: 40px; border-radius: 20px;
                    background: ca.pressed ? Theme.primary.transparentize(0.88) : transparent;
                    Text { text: "Отмена"; font-size: 15px; font-weight: 600; color: Theme.primary; horizontal-alignment: center; vertical-alignment: center; }
                    ca := TouchArea { clicked => { root.canceled(); } }
                }
            }
        }
        }
    }
}

component ChildItemCard inherits Rectangle {
    in property <string> name;
    in property <string> school-class;
    in property <string> school-name;
    in property <bool> selected;
    callback clicked();

    height: card-layout.preferred-height + 20px;
    border-radius: Theme.radius-m;
    background: root.selected ? (Theme.dark ? Theme.primary-container.transparentize(0.4) : Theme.surface-variant) : (ta.pressed ? Theme.surface-container-highest : Theme.surface-container-high);
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.primary : Theme.outline-variant;
    animate background { duration: 120ms; }

    card-layout := HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: root.selected ? Theme.primary : Theme.secondary-container;
                Path {
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
                    fill: root.selected ? Theme.on-primary : Theme.on-secondary-container;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.on-surface;
                overflow: elide;
                wrap: no-wrap;
            }
            if root.school-class != "" : Text {
                text: root.school-class + " класс";
                font-size: 12px;
                font-weight: 600;
                color: Theme.primary;
                overflow: elide;
                wrap: no-wrap;
            }
            if root.school-name != "" : Text {
                text: root.school-name;
                font-size: 11px;
                color: Theme.on-surface-variant;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        if root.selected : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: Theme.primary;
                Path {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z";
                    fill: Theme.on-primary;
                }
            }
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ChildSelectOverlay inherits Rectangle {
    in property <[ChildItem]> items;
    in property <bool> is-login: false;
    in property <bool> busy: false;
    in property <string> error;
    callback select-child(string);
    callback close();

    background: #00000088;

    TouchArea {
        clicked => {
            if (!root.is-login) {
                root.close();
            }
        }
    }

    Rectangle {
        width: min(root.width - 32px, 380px);
        height: min(card-content.preferred-height, root.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xl;
        background: Theme.surface-container;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        card-content := VerticalLayout {
            padding: 20px;
            spacing: 14px;

            HorizontalLayout {
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Выберите ребёнка";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: "Дневник и оценки выбранного ученика";
                        font-size: 12px;
                        color: Theme.on-surface-variant;
                    }
                }

                if !root.is-login : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: close-ta.pressed ? Theme.secondary-container : transparent;
                        Path {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M6 6 L18 18 M6 18 L18 6";
                            fill: transparent;
                            stroke: Theme.on-surface-variant;
                            stroke-width: 2px;
                        }
                        close-ta := TouchArea {
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.outline-variant; }
            if root.busy || root.error != "" : Text {
                text: root.busy ? "Загрузка…" : root.error;
                color: root.busy ? Theme.on-surface-variant : Theme.error;
                font-size: 12px;
                wrap: word-wrap;
            }

            Flickable {
                content-height: children-list.preferred-height;
                preferred-height: min(children-list.preferred-height, 300px);
                max-height: 300px;

                children-list := VerticalLayout {
                    spacing: 8px;
                    padding-bottom: 4px;

                    for item in root.items : ChildItemCard {
                        name: item.name;
                        school-class: item.school-class;
                        school-name: item.school-name;
                        selected: item.selected;
                        clicked => {
                            if !root.busy { root.select-child(item.guid); }
                        }
                    }
                }
            }

            if !root.is-login : HorizontalLayout {
                alignment: end;
                MaterialButton {
                    text: "Отмена";
                    filled: false;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Дневник";
    preferred-width: 1120px;
    preferred-height: 760px;
    background: Theme.background;

    in property <bool> mobile-device: false;
    property <bool> mobile: root.mobile-device || root.width < 760px;
    in property <string> net-stale;
    in property <[SubjectToggle]> subject-toggles;
    in property <[MobileSubjectGrades]> mobile-grade-subjects;
    in-out property <bool> subjects-open: false;
    callback toggle-subject-hidden(string, bool);
    in property <[RecentGrade]> recent-grades;
    in property <bool> logged-in: false;
    // Демо-сборка: вход и выход отключены, профиль показывает пояснение.
    in property <bool> demo-only: false;
    in property <string> full-name: "—";
    in property <string> school-name: "—";
    in property <string> school-class: "—";
    in property <string> guid: "—";
    in property <string> sid: "—";
    in property <image> avatar;
    in property <bool> has-avatar: false;
    in property <string> current-date: "—";
    // Числовая текущая дата — для нициализации календаря
    in property <int> cur-year;
    in property <int> cur-month;
    in property <int> cur-day;
    in property <[Lesson]> lessons;
    in property <string> net-error;
    in property <bool> loading;
    in property <string> login-error;
    in property <bool> logging-in;
    // --- Проверка обновлений ---
    in property <bool> update-available: false;
    in property <string> update-version;
    in property <string> update-url;
    private property <bool> update-dismissed: false;
    // Вкладка «Оценки»
    in property <[string]> grade-periods;
    in property <int> grade-selected;
    in property <[DesktopSubjectGrades]> grade-subjects;
    in property <[SubjectFinals]> grade-finals;
    in property <int> grade-mode;
    in property <bool> grades-loading;
    in property <string> grades-error;
    // График успеваемости за год
    in property <[ChartPoint]> chart-points;
    in property <[ChartDivider]> chart-dividers;
    in property <string> chart-line-path;
    in property <bool> chart-has-data;
    in property <bool> chart-loading;
    // На вебе системных отступов нет (сейчас только ночной режим по теме)
    in property <length> top-inset: 0px;
    // Данные для родителей
    in property <bool> is-parent: false;
    in property <string> parent-name: "";
    in property <string> current-child-guid: "";
    in property <[ChildItem]> children-list;
    in-out property <bool> child-select-open: false;
    in property <bool> child-select-is-login: false;

    callback login-requested();
    callback prev-day();
    callback next-day();
    callback logout();
    callback pick-avatar();
    callback open-url(string);
    callback refresh-day();
    callback grade-select(int);
    callback grade-mode-select(int);
    callback grade-open-chart(string);
    callback pick-date(int, int, int);   // год, месяц, день
    callback add-event(string, string, string);
    callback delete-event(string);
    callback toggle-homework(string, bool);
    callback save-note(string, string);
    callback demo-requested();
    callback tab-changed(int);
    callback cal-open-changed(bool);
    callback event-open-changed(bool);
    callback chart-open-changed(bool);
    callback sim-open-changed(bool);
    callback open-child-select();
    callback close-child-select();
    callback select-child(string);
    callback child-select-open-changed(bool);

    in-out property <int> tab: 0;
    in-out property <bool> cal-open: false;
    in-out property <bool> event-open: false;
    // Раскрытый drawer навигации (компактный rail 88px ↔ drawer 264px)
    in-out property <bool> rail-expanded: false;

    changed tab => { root.tab-changed(root.tab); }
    changed cal-open => { root.cal-open-changed(root.cal-open); }
    changed event-open => { root.event-open-changed(root.event-open); }
    changed child-select-open => { root.child-select-open-changed(root.child-select-open); }

    if !root.logged-in && !root.mobile : LoginScreen {
        width: 100%;
        height: 100%;
        login-error: root.login-error;
        logging-in: root.logging-in;
        login-requested => { root.login-requested(); }
        demo-requested => { root.demo-requested(); }
    }

    if root.logged-in && !root.mobile : HorizontalLayout {
        spacing: 0px;

        // Левая навигация (M3 Navigation Rail / Drawer):
        // компактный rail 88px ↔ раскрытый drawer 264px (кнопка-гамбургер).
        Rectangle {
            width: root.rail-expanded ? 264px : 88px;
            animate width { duration: 180ms; easing: ease-in-out; }
            background: Theme.nav-bg;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-x: 2px;

            VerticalLayout {
                padding-top: root.top-inset + 12px;
                padding-bottom: 12px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                // Гамбургер: свернуть/развернуть навигацию
                Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-m;
                    background: burger-ta.pressed ? Theme.surface-container-high : transparent;
                    HorizontalLayout {
                        alignment: start;
                        padding-left: root.rail-expanded ? 8px : 20px;
                        spacing: 14px;
                        Rectangle {
                            width: root.rail-expanded ? 56px : 24px;
                            height: 32px;
                            y: (parent.height - self.height) / 2;
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Path {
                                        width: 22px; height: 22px;
                                        viewbox-width: 24; viewbox-height: 24;
                                        commands: "M4 6 h16 M4 12 h16 M4 18 h16";
                                        fill: transparent;
                                        stroke: Theme.on-surface-variant;
                                        stroke-width: 2px;
                                    }
                                }
                            }
                        }
                        if root.rail-expanded : Text {
                            text: "Меню";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.on-surface-variant;
                            vertical-alignment: center;
                        }
                    }
                    burger-ta := TouchArea {
                        clicked => { root.rail-expanded = !root.rail-expanded; }
                    }
                }

                // FAB «добавить событие» — верх rail'а (M3 для больших экранов).
                // Компактный: квадрат-круг 56×56 по центру; раскрытый: extended.
                if root.tab == 0 : HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 56px;
                        width: root.rail-expanded ? parent.width : 56px;
                        border-radius: 16px;
                        background: fab-ta.pressed ? (Theme.dark ? Theme.primary-container : Theme.active-container).darker(0.08) : (Theme.dark ? Theme.primary-container : Theme.active-container);
                        drop-shadow-blur: 10px;
                        drop-shadow-color: Theme.shadow;
                        drop-shadow-offset-y: 3px;
                        // Компактный: плюс строго по центру (абсолютно)
                        if !root.rail-expanded : Path {
                            width: 24px;
                            height: 24px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M12 5 L12 19 M5 12 L19 12";
                            fill: transparent;
                            stroke: (Theme.dark ? Theme.on-primary-container : Theme.on-active-container);
                            stroke-width: 2.5px;
                        }
                        // Раскрытый: extended FAB — иконка и текст на одной
                        // линии с пилюлями и подписями пунктов навигации
                        if root.rail-expanded : HorizontalLayout {
                            alignment: start;
                            padding-left: 8px;
                            spacing: 14px;
                            Rectangle {
                                width: 56px;
                                height: 32px;
                                y: (parent.height - self.height) / 2;
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: center;
                                        Path {
                                            width: 24px;
                                            height: 24px;
                                            viewbox-width: 24;
                                            viewbox-height: 24;
                                            commands: "M12 5 L12 19 M5 12 L19 12";
                                            fill: transparent;
                                            stroke: (Theme.dark ? Theme.on-primary-container : Theme.on-active-container);
                                            stroke-width: 2.5px;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "Событие";
                                font-size: 14px;
                                font-weight: 700;
                                color: (Theme.dark ? Theme.on-primary-container : Theme.on-active-container);
                                vertical-alignment: center;
                            }
                        }
                        fab-ta := TouchArea {
                            clicked => { root.event-open = true; }
                        }
                    }
                }

                Rectangle { height: 4px; } // отступ до вкладок

                NavItem {
                    height: 64px;
                    wide: root.rail-expanded;
                    icon-id: 0; label: "Дневник"; selected: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                NavItem {
                    height: 64px;
                    wide: root.rail-expanded;
                    icon-id: 1; label: "Оценки"; selected: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                NavItem {
                    height: 64px;
                    wide: root.rail-expanded;
                    icon-id: 2; label: "Настройки"; selected: root.tab == 2;
                    clicked => { root.tab = 2; }
                }

                Rectangle { vertical-stretch: 1; }

                // Баг-репорт: тихий IconButton в самом низу навигации
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius-m;
                    background: bug-ta.pressed ? Theme.surface-container-high : transparent;
                    HorizontalLayout {
                        alignment: start;
                        padding-left: root.rail-expanded ? 16px : 12px;
                        spacing: root.rail-expanded ? 22px : 0px;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 12px;
                            background: Theme.surface-container-high;
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Path {
                                        width: 22px;
                                        height: 22px;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        commands: "M12 6.5 C14.8 6.5 17 9.4 17 13 C17 16.6 14.8 19.5 12 19.5 C9.2 19.5 7 16.6 7 13 C7 9.4 9.2 6.5 12 6.5 Z M12 8 L12 18 M12 3 C13.2 3 14.2 4 14.2 5.2 C14.2 6.4 13.2 7.4 12 7.4 C10.8 7.4 9.8 6.4 9.8 5.2 C9.8 4 10.8 3 12 3 Z M10.6 3.4 L9.2 1.8 M13.4 3.4 L14.8 1.8 M7.2 10 L3.8 8.4 M7 13 L3.3 13 M7.2 16 L3.8 17.6 M16.8 10 L20.2 8.4 M17 13 L20.7 13 M16.8 16 L20.2 17.6";
                                        fill: transparent;
                                        stroke: Theme.on-surface-variant;
                                        stroke-width: 1.8px;
                                    }
                                }
                            }
                        }
                        if root.rail-expanded : Text {
                            height: 40px;
                            text: "Сообщить о проблеме";
                            font-size: 14px;
                            color: Theme.on-surface-variant;
                            vertical-alignment: center;
                        }
                    }
                    bug-ta := TouchArea {
                        clicked => { root.open-url("https://forms.yandex.ru/u/6a4fcc2549af476d9920b49c"); }
                    }
                }
            }
        }

        // Правая колонка: баннер обновления + контент активной вкладки
        VerticalLayout {
            spacing: 0px;
            padding-top: root.top-inset;

        if root.update-available && !root.update-dismissed : Rectangle {
            height: 56px;
            background: Theme.secondary-container;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Path {
                        width: 22px; height: 22px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M16 18v2H8v-2h8zM11 7.83l-3.41 3.41L6.17 9.83 12 4l5.83 5.83-1.41 1.41L13 7.83V16h-2V7.83z";
                        fill: Theme.on-secondary-container;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Доступна версия " + root.update-version;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.on-secondary-container;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                // Кнопка "Скачать"
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 36px;
                        width: dl.preferred-width + 28px;
                        border-radius: 18px;
                        background: dl-ta.pressed ? Theme.primary.darker(0.12) : Theme.primary;
                        dl := Text {
                            text: "Скачать";
                            color: Theme.on-primary;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        dl-ta := TouchArea {
                            clicked => {
                                root.open-url(root.update-url);
                                root.update-dismissed = true;
                            }
                        }
                    }
                }

                // Крестик — иконкой, как везде в UI
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: x-ta.pressed ? Theme.secondary-container.darker(0.08) : transparent;
                        Path {
                            width: 15px;
                            height: 15px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M6 6 L18 18 M6 18 L18 6";
                            fill: transparent;
                            stroke: Theme.on-secondary-container;
                            stroke-width: 2px;
                        }
                        x-ta := TouchArea { clicked => { root.update-dismissed = true; } }
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            // Десктоп: контент — центрированная колонка ограниченной ширины,
            // а не растянутые на весь экран телефонные списки.
            content := Rectangle {
                width: min(parent.width, 1080px);
                x: (parent.width - self.width) / 2;
                height: 100%;
            if root.tab == 0 : DiaryView {
                event-open <=> root.event-open;
                recent-grades: root.recent-grades;
                lessons: root.lessons;
                net-error: root.net-error;
                loading: root.loading;
                width: 100%; height: 100%;
                current-date: root.current-date;
                cur-year: root.cur-year;
                cur-month: root.cur-month;
                cur-day: root.cur-day;
                prev-day => { root.prev-day(); }
                next-day => { root.next-day(); }
                open-calendar => { root.cal-open = true; }
                refresh => { root.refresh-day(); }
                pick-date(y, m, d) => { root.pick-date(y, m, d); }
                add-event(n, s, e) => { root.add-event(n, s, e); }
                delete-event(id) => { root.delete-event(id); }
                toggle-homework(k, d) => { root.toggle-homework(k, d); }
                save-note(k, t) => { root.save-note(k, t); }
            }
            if root.tab == 1 : GradesView {
                width: 100%; height: 100%;
                periods: root.grade-periods;
                selected: root.grade-selected;
                subjects: root.grade-subjects;
                finals: root.grade-finals;
                mode: root.grade-mode;
                loading: root.grades-loading;
                error: root.grades-error;
                chart-points: root.chart-points;
                chart-dividers: root.chart-dividers;
                chart-line-path: root.chart-line-path;
                chart-has-data: root.chart-has-data;
                chart-loading: root.chart-loading;
                select(i) => { root.grade-select(i); }
                select-mode(i) => { root.grade-mode-select(i); }
                open-chart(s) => { root.grade-open-chart(s); }
            }
            if root.tab == 2 : ProfileView {
                open-subjects => { root.subjects-open = true; }
                width: 100%; height: 100%;
                full-name: root.full-name;
                school-name: root.school-name;
                school-class: root.school-class;
                guid: root.guid;
                sid: root.sid;
                avatar: root.avatar;
                has-avatar: root.has-avatar;
                is-parent: root.is-parent;
                parent-name: root.parent-name;
                children-list: root.children-list;
                demo-only: root.demo-only;
                logout => { root.logout(); }
                pick-avatar => { root.pick-avatar(); }
                open-url(u) => { root.open-url(u); }
                open-child-select => { root.open-child-select(); }
            }
            } // /content wrapper
        }

        } // /правая колонка
    }


    if root.mobile && !root.logged-in : MobileLogin {
        width: 100%; height: 100%;
        login-error: root.login-error; logging-in: root.logging-in;
        login-requested => { root.login-requested(); }
        demo-requested => { root.demo-requested(); }
    }
    if root.mobile && root.logged-in : VerticalLayout {
        width: 100%; height: 100%;
        spacing: 0px;
        Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
            if root.tab == 0 : MobileDiary {
                width: 100%; height: 100%;
                viewport-resizes-for-keyboard: true;
                lessons: root.lessons; recent-grades: root.recent-grades;
                current-date: root.current-date; cur-year: root.cur-year; cur-month: root.cur-month; cur-day: root.cur-day;
                loading: root.loading; net-error: root.net-error; net-stale: root.net-stale;
                event-open <=> root.event-open;
                prev-day => { root.prev-day(); } next-day => { root.next-day(); }
                refresh => { root.refresh-day(); } open-calendar => { root.cal-open = true; }
                pick-date(y,m,d) => { root.pick-date(y,m,d); }
                add-event(n,s,e) => { root.add-event(n,s,e); } delete-event(id) => { root.delete-event(id); }
                toggle-homework(k,d) => { root.toggle-homework(k,d); } save-note(k,t) => { root.save-note(k,t); }
            }
            if root.tab == 1 : MobileGrades {
                width: 100%; height: 100%;
                periods: root.grade-periods; selected: root.grade-selected; subjects: root.mobile-grade-subjects;
                finals: root.grade-finals; mode: root.grade-mode; loading: root.grades-loading; error: root.grades-error;
                chart-points: root.chart-points; chart-dividers: root.chart-dividers; chart-line-path: root.chart-line-path;
                chart-has-data: root.chart-has-data; chart-loading: root.chart-loading;
                select(i) => { root.grade-select(i); } select-mode(i) => { root.grade-mode-select(i); }
                open-chart(s) => { root.grade-open-chart(s); }
            }
            if root.tab == 2 : MobileProfile {
                demo-only: root.demo-only;
                width: 100%; height: 100%;
                full-name: root.full-name; school-name: root.school-name; school-class: root.school-class;
                guid: root.guid; avatar: root.avatar; has-avatar: root.has-avatar;
                is-parent: root.is-parent; parent-name: root.parent-name; children-list: root.children-list;
                logout => { root.logout(); } pick-avatar => { root.pick-avatar(); } open-url(u) => { root.open-url(u); }
                open-child-select => { root.open-child-select(); } open-subjects => { root.subjects-open = true; }
            }
        }
        Rectangle {
            min-height: 72px; max-height: 72px;
            background: Theme.nav-bg;
            HorizontalLayout {
                spacing: 0px;
                MobileNavItem { icon-id: 0; label: "Дневник"; selected: root.tab == 0; clicked => { root.tab = 0; } }
                MobileNavItem { icon-id: 1; label: "Оценки"; selected: root.tab == 1; clicked => { root.tab = 1; } }
                MobileNavItem { icon-id: 2; label: "Профиль"; selected: root.tab == 2; clicked => { root.tab = 2; } }
            }
        }
    }
    if root.subjects-open : SubjectsOverlay {
        width: 100%; height: 100%; items: root.subject-toggles;
        toggle-subject-hidden(s,h) => { root.toggle-subject-hidden(s,h); }
        close => { root.subjects-open = false; }
    }
    // --- Оверлей русского календаря (поверх всего) ---
    if root.cal-open : RuCalendar {
        width: 100%;
        height: 100%;
        init-year: root.cur-year;
        init-month: root.cur-month;
        init-day: root.cur-day;
        accepted(y, m, d) => {
            root.pick-date(y, m, d);
            root.cal-open = false;
        }
        canceled => { root.cal-open = false; }
    }

    // --- Поповер «Новое событие» — справа от кнопки «+» в rail'е ---
    if root.event-open && !root.mobile : EventSheet {
        width: 100%;
        height: 100%;
        rail-expanded: root.rail-expanded;
        save(n, s, e) => { root.add-event(n, s, e); }
        close => { root.event-open = false; }
    }

    // --- Оверлей выбора ребёнка (для родителей) ---
    if root.child-select-open : ChildSelectOverlay {
        width: 100%;
        height: 100%;
        items: root.children-list;
        is-login: root.child-select-is-login;
        busy: root.logging-in;
        error: root.login-error;
        select-child(g) => { root.select-child(g); }
        close => { root.close-child-select(); }
    }
}

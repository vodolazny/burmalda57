// Reuse the Android UI on narrow/touch screens; browser transport stays in Rust.
import { DiaryView as MobileDiary } from "../../../crates/ui/ui/views/diary.slint";
import { GradesView as MobileGrades } from "../../../crates/ui/ui/views/grades.slint";
import { ProfileView as MobileProfile } from "../../../crates/ui/ui/views/profile.slint";
import { LoginScreen as MobileLogin } from "../../../crates/ui/ui/views/login.slint";
import { NavItem as MobileNavItem } from "../../../crates/ui/ui/components/navigation.slint";
import { AccentPicker } from "../../../crates/ui/ui/components/appearance.slint";
import { SubjectsOverlay } from "../../../crates/ui/ui/views/subjects_overlay.slint";
import { Theme as MobileTheme } from "../../../crates/ui/ui/theme.slint";
// Shared views and their callers must use the same Slint struct definitions.
export {
    Lesson, ChildItem, RecentGrade, FinalMark, SubjectFinals,
    ChartPoint, ChartDivider, SubjectChart, SubjectToggle,
    SubjectGrades as MobileSubjectGrades, GradeMark as MobileGradeMark,
} from "../../../crates/ui/ui/types.slint";
import {
    Lesson, ChildItem, RecentGrade, FinalMark, SubjectFinals,
    ChartPoint, ChartDivider, SubjectChart, SubjectToggle,
    SubjectGrades as MobileSubjectGrades,
    GradeMark as DesktopGradeMark,
} from "../../../crates/ui/ui/types.slint";
import { LightPalette } from "../../../crates/ui/ui/light_palette.slint";
export { Theme as MobileTheme, Validate as MobileValidate } from "../../../crates/ui/ui/theme.slint";
export { GradeMath, GradeSimulation } from "../../../crates/ui/ui/grade_math.slint";
import { GradeMath, GradeSimulation } from "../../../crates/ui/ui/grade_math.slint";

// Проверка времени (реализация в Rust). invalid(s) == true — формат/диапазон неверный.
// Пустая строка считается корректной. Если Rust не подключит колбэк, по умолчанию false (валидация отключена).
export global Validate {
    pure callback invalid(string) -> bool;
}

// Одна оценка в ленте предмета
// Предмет со средним баллом и списком оценок за период
export struct DesktopSubjectGrades {
    subject: string,
    average: string,     // отформатированное "4.64" или "—"
    average-val: float,  // число — для цвета бейджа
    marks: [DesktopGradeMark],
    n5: int,             // количество пятёрок (для распределения и прогноза)
    n4: int,
    n3: int,
    n2: int,
}

// ============================================================
//  Material 3 — цветовые роли (tonal surfaces + accent)
// ============================================================
export global Theme {
    out property <bool> dark: MobileTheme.dark;
    out property <color> active-container: MobileTheme.active-container;
    out property <color> on-active-container: MobileTheme.on-active-container;
    public pure function work-container(kind: string) -> color { return MobileTheme.work-container(kind); }
    public pure function on-work-container(kind: string) -> color { return MobileTheme.on-work-container(kind); }

    out property <int> accent-color: MobileTheme.accent-color;
    out property <color> primary: MobileTheme.primary;
    out property <color> on-primary: MobileTheme.on-primary;
    out property <color> primary-container: MobileTheme.primary-container;
    out property <color> on-primary-container: MobileTheme.on-primary-container;
    out property <color> secondary-container: MobileTheme.secondary-container;
    out property <color> on-secondary-container: MobileTheme.on-secondary-container;
    out property <color> surface: MobileTheme.surface;
    out property <color> on-surface: MobileTheme.on-surface;
    out property <color> on-surface-variant: MobileTheme.on-surface-variant;
    out property <color> outline: MobileTheme.outline;

    // ================================================================
    //  Dark elevation stays unchanged; light surfaces use explicit tonal roles.
    // ================================================================
    out property <color> background:                surface;
    out property <color> surface-card: dark ? surface-container : LightPalette.surface-card;
    out property <color> surface-variant: dark ? surface.mix(primary, 0.86) : LightPalette.surface-variant(accent-color);
    out property <color> surface-container-low:     dark ? surface.mix(primary, 0.96) : LightPalette.surface-card;
    out property <color> surface-container:         dark ? surface.mix(primary, 0.91) : LightPalette.surface-card;
    out property <color> surface-container-high:    dark ? surface.mix(primary, 0.86) : surface-variant;
    out property <color> surface-container-highest: dark ? surface.mix(primary, 0.82) : LightPalette.surface-highest(accent-color);
    out property <color> outline-variant:           dark ? surface.mix(primary, 0.70) : LightPalette.outline-variant(accent-color);
    out property <color> nav-bg:                    dark ? surface.mix(primary, 0.92) : LightPalette.surface-card;
    out property <color> shadow:             dark ? #00000066 : #0000001F;

    // --- Ошибки (M3 error roles) ---
    out property <color> error:              dark ? #F2B8B5 : #B3261E;
    out property <color> error-container:    dark ? #8C1D18 : #F9DEDC;
    out property <color> on-error-container:  dark ? #F9DEDC : #410E0B;

    // --- Производные ---
    out property <color> primary-2: primary.brighter(0.12);

    // --- Цвета оценок (светлее/пастельнее в тёмной теме — для контраста) ---
    out property <color> mark-5: dark ? #7FD98A : LightPalette.on-success-container;
    out property <color> mark-4: dark ? #7FB2F0 : LightPalette.on-mark-4-container;
    out property <color> mark-3: dark ? #F5B871 : LightPalette.on-mark-3-container;
    out property <color> mark-2: dark ? #F0918C : LightPalette.on-mark-2-container;

    out property <color> success-container: LightPalette.success-container;
    out property <color> mark-4-container: LightPalette.mark-4-container;
    out property <color> mark-3-container: LightPalette.mark-3-container;
    out property <color> mark-2-container: LightPalette.mark-2-container;

    // --- Форма (M3 shape scale, строже) ---
    out property <length> radius-s: 8px;
    out property <length> radius-m: 12px;
    out property <length> radius-l: 12px;
    out property <length> radius-xl: 20px;
}

// ---------------------------------------------------------------------
//  Material Design 3 Expressive: LoadingIndicator (Uncontained)
//  Exact shapes from Material 3 Expressive specification:
//  - Shape A: 12-lobed Soft Scallop Cookie / Sunny Rosette
//  - Shape B: 4-lobed Puffy Pillow / Soft Square Blob
//  - 100% continuous, smooth harmonic morphing + continuous rotation
// ---------------------------------------------------------------------
component Md3LoadingIndicator inherits Rectangle {
    in property <brush> indicator-color: Theme.primary;

    min-width: 36px;
    min-height: 36px;
    clip: false;

    path := Path {
        private property <float> cx: 50;
        private property <float> cy: 50;

        private property <float> t: animation-tick() / 1ms;

        private property <float> rot: mod(t * 0.13, 360.0);

        private property <float> morph: 0.5 - 0.5 * cos(t / 2200.0 * 360deg);

        private property <float> scale: 1.0 + 0.04 * sin(t / 1100.0 * 360deg);

        private property <float> a12: 2.6 * (1.0 - morph);
        private property <float> a4:  7.2 * morph;
        private property <float> r-base: 34.0 * scale;

     
        private property <float> r0:  r-base + a4 * cos(0deg)   + a12 * cos(0deg);
        private property <float> x0:  cx + r0 * cos(rot * 1deg + 0deg);
        private property <float> y0:  cy + r0 * sin(rot * 1deg + 0deg);

        private property <float> r1:  r-base + a4 * cos(60deg)  + a12 * cos(180deg);
        private property <float> x1:  cx + r1 * cos(rot * 1deg + 15deg);
        private property <float> y1:  cy + r1 * sin(rot * 1deg + 15deg);

        private property <float> r2:  r-base + a4 * cos(120deg) + a12 * cos(360deg);
        private property <float> x2:  cx + r2 * cos(rot * 1deg + 30deg);
        private property <float> y2:  cy + r2 * sin(rot * 1deg + 30deg);

        private property <float> r3:  r-base + a4 * cos(180deg) + a12 * cos(540deg);
        private property <float> x3:  cx + r3 * cos(rot * 1deg + 45deg);
        private property <float> y3:  cy + r3 * sin(rot * 1deg + 45deg);

        private property <float> r4:  r-base + a4 * cos(240deg) + a12 * cos(720deg);
        private property <float> x4:  cx + r4 * cos(rot * 1deg + 60deg);
        private property <float> y4:  cy + r4 * sin(rot * 1deg + 60deg);

        private property <float> r5:  r-base + a4 * cos(300deg) + a12 * cos(900deg);
        private property <float> x5:  cx + r5 * cos(rot * 1deg + 75deg);
        private property <float> y5:  cy + r5 * sin(rot * 1deg + 75deg);

        private property <float> r6:  r-base + a4 * cos(360deg) + a12 * cos(1080deg);
        private property <float> x6:  cx + r6 * cos(rot * 1deg + 90deg);
        private property <float> y6:  cy + r6 * sin(rot * 1deg + 90deg);

        private property <float> r7:  r-base + a4 * cos(420deg) + a12 * cos(1260deg);
        private property <float> x7:  cx + r7 * cos(rot * 1deg + 105deg);
        private property <float> y7:  cy + r7 * sin(rot * 1deg + 105deg);

        private property <float> r8:  r-base + a4 * cos(480deg) + a12 * cos(1440deg);
        private property <float> x8:  cx + r8 * cos(rot * 1deg + 120deg);
        private property <float> y8:  cy + r8 * sin(rot * 1deg + 120deg);

        private property <float> r9:  r-base + a4 * cos(540deg) + a12 * cos(1620deg);
        private property <float> x9:  cx + r9 * cos(rot * 1deg + 135deg);
        private property <float> y9:  cy + r9 * sin(rot * 1deg + 135deg);

        private property <float> r10: r-base + a4 * cos(600deg) + a12 * cos(1800deg);
        private property <float> x10: cx + r10 * cos(rot * 1deg + 150deg);
        private property <float> y10: cy + r10 * sin(rot * 1deg + 150deg);

        private property <float> r11: r-base + a4 * cos(660deg) + a12 * cos(1980deg);
        private property <float> x11: cx + r11 * cos(rot * 1deg + 165deg);
        private property <float> y11: cy + r11 * sin(rot * 1deg + 165deg);

        private property <float> r12: r-base + a4 * cos(720deg) + a12 * cos(2160deg);
        private property <float> x12: cx + r12 * cos(rot * 1deg + 180deg);
        private property <float> y12: cy + r12 * sin(rot * 1deg + 180deg);

        private property <float> r13: r-base + a4 * cos(780deg) + a12 * cos(2340deg);
        private property <float> x13: cx + r13 * cos(rot * 1deg + 195deg);
        private property <float> y13: cy + r13 * sin(rot * 1deg + 195deg);

        private property <float> r14: r-base + a4 * cos(840deg) + a12 * cos(2520deg);
        private property <float> x14: cx + r14 * cos(rot * 1deg + 210deg);
        private property <float> y14: cy + r14 * sin(rot * 1deg + 210deg);

        private property <float> r15: r-base + a4 * cos(900deg) + a12 * cos(2700deg);
        private property <float> x15: cx + r15 * cos(rot * 1deg + 225deg);
        private property <float> y15: cy + r15 * sin(rot * 1deg + 225deg);

        private property <float> r16: r-base + a4 * cos(960deg) + a12 * cos(2880deg);
        private property <float> x16: cx + r16 * cos(rot * 1deg + 240deg);
        private property <float> y16: cy + r16 * sin(rot * 1deg + 240deg);

        private property <float> r17: r-base + a4 * cos(1020deg) + a12 * cos(3060deg);
        private property <float> x17: cx + r17 * cos(rot * 1deg + 255deg);
        private property <float> y17: cy + r17 * sin(rot * 1deg + 255deg);

        private property <float> r18: r-base + a4 * cos(1080deg) + a12 * cos(3240deg);
        private property <float> x18: cx + r18 * cos(rot * 1deg + 270deg);
        private property <float> y18: cy + r18 * sin(rot * 1deg + 270deg);

        private property <float> r19: r-base + a4 * cos(1140deg) + a12 * cos(3420deg);
        private property <float> x19: cx + r19 * cos(rot * 1deg + 285deg);
        private property <float> y19: cy + r19 * sin(rot * 1deg + 285deg);

        private property <float> r20: r-base + a4 * cos(1200deg) + a12 * cos(3600deg);
        private property <float> x20: cx + r20 * cos(rot * 1deg + 300deg);
        private property <float> y20: cy + r20 * sin(rot * 1deg + 300deg);

        private property <float> r21: r-base + a4 * cos(1260deg) + a12 * cos(3780deg);
        private property <float> x21: cx + r21 * cos(rot * 1deg + 315deg);
        private property <float> y21: cy + r21 * sin(rot * 1deg + 315deg);

        private property <float> r22: r-base + a4 * cos(1320deg) + a12 * cos(3960deg);
        private property <float> x22: cx + r22 * cos(rot * 1deg + 330deg);
        private property <float> y22: cy + r22 * sin(rot * 1deg + 330deg);

        private property <float> r23: r-base + a4 * cos(1380deg) + a12 * cos(4140deg);
        private property <float> x23: cx + r23 * cos(rot * 1deg + 345deg);
        private property <float> y23: cy + r23 * sin(rot * 1deg + 345deg);

        viewbox-width: 100;
        viewbox-height: 100;
        width: 100%;
        height: 100%;
        fill: root.indicator-color;

        MoveTo { x: x0; y: y0; }
        LineTo { x: x1; y: y1; }
        LineTo { x: x2; y: y2; }
        LineTo { x: x3; y: y3; }
        LineTo { x: x4; y: y4; }
        LineTo { x: x5; y: y5; }
        LineTo { x: x6; y: y6; }
        LineTo { x: x7; y: y7; }
        LineTo { x: x8; y: y8; }
        LineTo { x: x9; y: y9; }
        LineTo { x: x10; y: y10; }
        LineTo { x: x11; y: y11; }
        LineTo { x: x12; y: y12; }
        LineTo { x: x13; y: y13; }
        LineTo { x: x14; y: y14; }
        LineTo { x: x15; y: y15; }
        LineTo { x: x16; y: y16; }
        LineTo { x: x17; y: y17; }
        LineTo { x: x18; y: y18; }
        LineTo { x: x19; y: y19; }
        LineTo { x: x20; y: y20; }
        LineTo { x: x21; y: y21; }
        LineTo { x: x22; y: y22; }
        LineTo { x: x23; y: y23; }
    }
}

// Цвет оценки по её значению (общий помощник)
component MarkColor {
    in property <int> value;
    out property <color> fg: value >= 5 ? Theme.mark-5
                           : value == 4 ? Theme.mark-4
                           : value == 3 ? Theme.mark-3
                           : value >  0 ? Theme.mark-2
                           :              Theme.on-surface-variant;
    out property <color> container: value >= 5 ? Theme.success-container
                                  : value == 4 ? Theme.mark-4-container
                                  : value == 3 ? Theme.mark-3-container
                                  : value > 0 ? Theme.mark-2-container
                                  : Theme.surface-variant;
}

// M3 tonal-жетон оценки. Отдельная фигура — только для оценки.
component MarkToken inherits Rectangle {
    in property <string> text;
    in property <int> value;
    in property <length> size: 44px;
    in property <length> font: 18px;

    property <color> fg: mc.fg;
    mc := MarkColor { value: root.value; }

    width: max(root.size, txt.preferred-width + 16px);
    height: root.size;
    border-radius: root.size / 4;
    background: Theme.dark ? root.fg.transparentize(0.88) : mc.container;
    border-width: Theme.dark ? 1px : 0px;
    border-color: root.fg.transparentize(0.7);

    txt := Text {
        width: 100%; height: 100%;
        text: root.text;
        font-size: root.font;
        font-weight: 700;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Крупная карточка недавней оценки (прямоугольная, скруглённая, M3 filled card)
component RecentGradeCard inherits Rectangle {
    in property <string> subject;
    in property <string> mark;
    in property <int> mark-val;
    in property <string> date;

    width: 132px;
    height: 116px;
    border-radius: Theme.radius-l;
    background: Theme.dark ? Theme.surface-container-high : Theme.surface-card;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Дата выставления оценки
        Text {
            text: root.date;
            font-size: 11px;
            font-weight: 600;
            color: Theme.on-surface-variant;
            overflow: elide;
            wrap: no-wrap;
        }

        // Крупный жетон оценки
        HorizontalLayout {
            alignment: start;
            MarkToken {
                text: root.mark;
                value: root.mark-val;
                size: 44px;
                font: 22px;
            }
        }

        // Прижимаем предмет к низу карточки
        Rectangle { vertical-stretch: 1; }

        Text {
            text: root.subject;
            font-size: 12px;
            font-weight: 500;
            color: Theme.on-surface;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

// M3 filled / outlined кнопка
component MaterialButton inherits Rectangle {
    in property <string> text;
    in property <bool> filled: true;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    background: root.filled
        ? (ta.pressed ? Theme.primary.darker(0.12) : Theme.primary)
        : (ta.pressed ? Theme.primary.transparentize(0.88) : transparent);
    border-width: root.filled ? 0px : 1px;
    border-color: Theme.outline;
    animate background { duration: 120ms; }
    HorizontalLayout {
        alignment: center;
        padding-left: 24px;
        padding-right: 24px;
        Text {
            text: root.text;
            color: root.filled ? Theme.on-primary : Theme.primary;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Круглая иконка-кнопка для верхней панели (40dp, M3 icon button)
component RoundIconButton inherits Rectangle {
    in property <string> icon;
    in property <string> text: "";   // tooltip-подпись не рисуем, только icon
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: ta.pressed ? Theme.secondary-container.darker(0.08) : Theme.secondary-container;
    Path {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: transparent;
        stroke: Theme.on-secondary-container;
        stroke-width: 2px;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Строка детали (иконка + текст) для раскрытой карточки урока
component DetailRow inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    spacing: 8px;

    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        Path {
            width: 15px;
            height: 15px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon;
            fill: transparent;
            stroke: Theme.on-surface-variant;
            stroke-width: 1.6px;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 1px;
        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 600;
            color: Theme.on-surface-variant;
        }
        Text {
            text: root.value;
            font-size: 13px;
            color: Theme.on-surface;
            wrap: word-wrap;
        }
    }
}

// ============================================================
//  Карточка урока — раскрывается по тапу (тема + ДЗ)
// ============================================================
component LessonCard inherits Rectangle {
    in property <int>    number;
    in property <string> time;
    in property <string> subject;
    in property <string> room;
    in property <string> homework;
    in property <string> topic;
    in property <string> teacher;
    in property <string> mark;
    in property <int>    mark-value;
    in property <string> absence;
    in property <string> grade-type;
    in property <bool>   is-event;
    in property <string> event-id;
    in property <bool>   hw-done;
    in property <string> hw-key;
    in property <string> note;
    callback delete-requested();
    callback toggle-homework(string, bool);
    // Десктоп: тап выбирает урок (детали — в правой панели), а не раскрывает карточку
    in property <bool> selectable: false;
    in property <bool> active: false;
    callback select();

    // Локальное состояние чекбокса ДЗ: инициализируется из hw-done,
    // после тапа — своё значение (перебивает биндинг для этого инстанса).
    property <bool> done: root.hw-done;
    property <bool> has-hw: root.homework != "";
    property <bool> has-topic: root.topic != "";
    property <bool> has-details: root.has-hw || root.has-topic;
    property <bool> has-absence: root.absence != "";
    property <bool> has-gtype: root.grade-type != "";
    property <bool> expanded: false;

    // Высота = высота контента. Плавность даёт анимация высоты блока
    // деталей (details-clip) ниже: card.preferred-height меняется покадрово.
    // min/max-height (не height!) — потому что LessonCard лежит в VerticalLayout,
    // который игнорирует явную height (из-за этого карточка и прыгала).
    min-height: card.preferred-height + 10px;
    max-height: self.min-height;
    background: transparent;

    card := Rectangle {
        x: 12px;
        y: 5px;
        width: parent.width - 24px;
        height: parent.height - 10px;
        border-radius: Theme.radius-l;
        background: root.active
            ? (Theme.dark ? Theme.secondary-container.transparentize(0.55) : Theme.surface-variant)
            : Theme.surface-container;
        border-width: root.active ? 2px : 0px;
        border-color: Theme.primary;
        clip: true;

        // Тап по карточке — выбрать (десктоп) или раскрыть/свернуть.
        // Объявлен ДО контента, чтобы интерактивные элементы (чекбокс ДЗ,
        // удаление) были поверх и ловили тап.
        ta := TouchArea {
            clicked => {
                if (root.selectable) {
                    root.select();
                } else if (root.has-details) {
                    root.expanded = !root.expanded;
                }
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 0px;

            // --- Основная строка урока ---
            HorizontalLayout {
                spacing: 12px;

                // Leading: номер урока (или иконка-звёздочка для события)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: root.is-event ? Theme.primary-container : Theme.secondary-container;
                        if !root.is-event : Text {
                            text: "\{root.number}";
                            font-size: 17px;
                            font-weight: 700;
                            color: Theme.on-secondary-container;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if root.is-event : Path {
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M12 3 L14.6 8.3 L20.4 9.1 L16.2 13.2 L17.2 19 L12 16.3 L6.8 19 L7.8 13.2 L3.6 9.1 L9.4 8.3 Z";
                            fill: Theme.on-primary-container;
                            stroke: transparent;
                        }
                    }
                }

                // Контент: растягивается на всё свободное место
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.subject;
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.on-surface;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    Text {
                        text: root.teacher + (root.room != "" ? "  —  " + root.room : "");
                        font-size: 12px;
                        color: Theme.on-surface-variant;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    Text {
                        text: root.time;
                        font-size: 11px;
                        color: Theme.on-surface-variant;
                        overflow: elide;
                        wrap: no-wrap;
                    }

                    // Чип: вид работы (тональный)
                    if root.has-gtype : HorizontalLayout {
                        alignment: start;
                        padding-top: 3px;

                        Rectangle {
                            background: Theme.work-container(root.grade-type);
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                Text {
                                    text: root.grade-type;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.on-work-container(root.grade-type);
                                }
                            }
                        }
                    }
                }

                if root.note != "" && !root.is-event : VerticalLayout {
                    alignment: center;
                    Path {
                        width: 16px; height: 16px;
                        viewbox-width: 24; viewbox-height: 24;
                        commands: "M4 20 h4 L19 9 a2 2 0 0 0 -3 -3 L5 17 z M15 6 l3 3";
                        fill: transparent;
                        stroke: Theme.primary;
                        stroke-width: 1.8px;
                    }
                }

                // Trailing: оценка; если её нет, а есть пропуск — ставим пропуск
                if root.mark-value > 0 : VerticalLayout {
                    alignment: center;
                    MarkToken {
                        text: root.mark;
                        value: root.mark-value;
                        size: 44px;
                        font: 20px;
                    }
                }
                if root.mark-value <= 0 && root.has-absence : VerticalLayout {
                    alignment: center;
                    // Пропуск — такой же токен, как оценка
                    MarkToken {
                        text: "П";
                        value: 2;
                        size: 44px;
                        font: 20px;
                    }
                }

                // Кнопка удаления — только для своих событий
                if root.is-event : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: del-ta.pressed ? Theme.error-container : transparent;
                        Path {
                            width: 15px;
                            height: 15px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M6 6 L18 18 M6 18 L18 6";
                            fill: transparent;
                            stroke: Theme.on-surface-variant;
                            stroke-width: 2px;
                        }
                        del-ta := TouchArea {
                            clicked => { root.delete-requested(); }
                        }
                    }
                }

            }

            // --- Раскрытые детали ---
            // Всегда в дереве. Сворачивание/раскрытие — плавная анимация высоты
            // контейнера с обрезкой (clip), поэтому контент не исчезает мгновенно
            // и карточка не «прыгает» ни при открытии, ни при закрытии.
            details-clip := Rectangle {
                clip: true;
                min-height: (root.expanded && root.has-details) ? details-inner.preferred-height : 0px;
                max-height: self.min-height;
                animate min-height { duration: 200ms; easing: ease-in-out; }

                details-inner := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: self.preferred-height;
                    padding-top: 12px;
                    spacing: 10px;

                    Rectangle {
                        height: 1px;
                        background: Theme.on-surface-variant.transparentize(0.88);
                    }

                    if root.has-topic : DetailRow {
                        label: "Тема урока";
                        value: root.topic;
                        icon: "M4 7 h16 M4 12 h16 M4 17 h11";
                    }
                    if root.has-hw : HorizontalLayout {
                        spacing: 10px;
                        DetailRow {
                            horizontal-stretch: 1;
                            label: "Домашнее задание";
                            value: root.homework;
                            icon: "M7 3 h7 l4 4 v13 a1 1 0 0 1 -1 1 h-10 a1 1 0 0 1 -1 -1 v-17 a1 1 0 0 1 1 -1 z M14 3 v4 h4 M8.5 12.5 h7 M8.5 16 h5";
                        }
                        // Чекбокс «выполнено» — локальная отметка
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 8px;
                                background: root.done ? Theme.primary : transparent;
                                border-width: root.done ? 0px : 2px;
                                border-color: Theme.outline;
                                Path {
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: root.done ? "M5 13 L10 18 L19 7" : "";
                                    fill: transparent;
                                    stroke: Theme.on-primary;
                                    stroke-width: 2.5px;
                                }
                                hw-ta := TouchArea {
                                    clicked => {
                                        root.done = !root.done;
                                        root.toggle-homework(root.hw-key, root.done);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

    }
}

// Панель деталей выбранного урока (десктоп, правая колонка дневника)
component LessonDetail inherits Rectangle {
    in property <Lesson> lesson;
    callback toggle-homework(string, bool);
    callback save-note(string, string);
    background: transparent;

    property <string> note-draft: root.lesson.note;
    property <string> displayed-note-key;
    property <bool> note-saved: false;
    property <bool> done: root.lesson.hw-done;
    property <bool> has-hw: root.lesson.homework != "";
    property <bool> has-topic: root.lesson.topic != "";
    property <bool> has-gtype: root.lesson.grade-type != "";
    property <bool> has-anything: root.has-hw || root.has-topic || root.has-gtype
        || root.lesson.mark-value > 0 || root.lesson.absence != "";

    changed lesson => {
        self.done = root.lesson.hw-done;
        if (root.displayed-note-key != root.lesson.note-key) {
            root.note-saved = false;
        }
        root.displayed-note-key = root.lesson.note-key;
        root.note-draft = root.lesson.note;
    }

    Rectangle {
        x: 12px; y: 5px;
        width: parent.width - 24px;
        height: parent.height - 10px;
        border-radius: Theme.radius-l;
        background: Theme.surface-container-low;
        border-width: 1px;
        border-color: Theme.outline-variant;
        clip: true;

        Flickable {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: dcol.preferred-height;

            dcol := VerticalLayout {
                width: parent.width;
                padding: 18px;
                spacing: 14px;
                alignment: start;

                Text {
                    text: "Детали урока";
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    color: Theme.on-surface-variant;
                }

                // Заголовок: номер + предмет
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 44px; height: 44px;
                        border-radius: 22px;
                        background: root.lesson.is-event ? Theme.primary-container : Theme.secondary-container;
                        if !root.lesson.is-event : Text {
                            width: 100%; height: 100%;
                            text: "\{root.lesson.number}";
                            font-size: 18px; font-weight: 700;
                            color: Theme.on-secondary-container;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        if root.lesson.is-event : Path {
                            width: 22px; height: 22px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24; viewbox-height: 24;
                            commands: "M12 3 L14.6 8.3 L20.4 9.1 L16.2 13.2 L17.2 19 L12 16.3 L6.8 19 L7.8 13.2 L3.6 9.1 L9.4 8.3 Z";
                            fill: Theme.on-primary-container;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.lesson.subject;
                            font-size: 19px;
                            font-weight: 800;
                            color: Theme.on-surface;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.lesson.teacher;
                            font-size: 13px;
                            color: Theme.on-surface-variant;
                            overflow: elide;
                            wrap: no-wrap;
                        }
                    }
                    if root.lesson.mark-value > 0 : VerticalLayout {
                        alignment: center;
                        MarkToken {
                            text: root.lesson.mark;
                            value: root.lesson.mark-value;
                            size: 44px;
                            font: 20px;
                        }
                    }
                    if root.lesson.mark-value <= 0 && root.lesson.absence != "" : VerticalLayout {
                        alignment: center;
                        MarkToken { text: "П"; value: 2; size: 44px; font: 20px; }
                    }
                }

                // Мета-информация
                HorizontalLayout {
                    spacing: 8px;
                    if root.lesson.time != "" : Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.surface-container-high;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                            Text { text: root.lesson.time; font-size: 12px; font-weight: 600; color: Theme.on-surface-variant; vertical-alignment: center; }
                        }
                    }
                    if root.lesson.room != "" : Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.surface-container-high;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                            Text { text: "каб. " + root.lesson.room; font-size: 12px; font-weight: 600; color: Theme.on-surface-variant; vertical-alignment: center; }
                        }
                    }
                    if root.has-gtype : Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.work-container(root.lesson.grade-type);
                        HorizontalLayout { padding-left: 12px; padding-right: 12px;
                            Text { text: root.lesson.grade-type; font-size: 12px; font-weight: 700; color: Theme.on-work-container(root.lesson.grade-type); vertical-alignment: center; }
                        }
                    }
                }

                if !root.lesson.is-event : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "Заметка к уроку"; font-size: 14px; font-weight: 600; color: Theme.on-surface; horizontal-stretch: 1; }
                        if root.note-saved : Text {
                            text: "Сохранено"; font-size: 11px; color: Theme.primary;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 112px; border-radius: 12px;
                        background: Theme.surface-container;
                        border-width: 1px; border-color: Theme.outline-variant;
                        TextInput {
                            x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
                            text <=> root.note-draft;
                            single-line: false; wrap: word-wrap;
                            font-size: 14px; color: Theme.on-surface;
                            edited => {
                                root.save-note(root.lesson.note-key, self.text);
                                root.note-saved = true;
                            }
                        }
                    }
                }

                if !root.has-anything : Text {
                    text: "По этому уроку нет дополнительных сведений.";
                    font-size: 13px;
                    color: Theme.on-surface-variant;
                    wrap: word-wrap;
                }

                if root.has-topic : Rectangle {
                    border-radius: Theme.radius-m;
                    background: Theme.surface-container;
                    HorizontalLayout {
                        padding: 14px;
                        DetailRow {
                            horizontal-stretch: 1;
                            label: "Тема урока";
                            value: root.lesson.topic;
                            icon: "M4 7 h16 M4 12 h16 M4 17 h11";
                        }
                    }
                }

                if root.has-hw : Rectangle {
                    border-radius: Theme.radius-m;
                    background: Theme.surface-container;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 10px;
                        DetailRow {
                            horizontal-stretch: 1;
                            label: "Домашнее задание";
                            value: root.lesson.homework;
                            icon: "M7 3 h7 l4 4 v13 a1 1 0 0 1 -1 1 h-10 a1 1 0 0 1 -1 -1 v-17 a1 1 0 0 1 1 -1 z M14 3 v4 h4 M8.5 12.5 h7 M8.5 16 h5";
                        }
                        VerticalLayout {
                            alignment: start;
                            padding-top: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 32px; height: 32px;
                                    border-radius: 8px;
                                    background: root.done ? Theme.primary : transparent;
                                    border-width: root.done ? 0px : 2px;
                                    border-color: Theme.outline;
                                    Path {
                                        width: 18px; height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-width: 24; viewbox-height: 24;
                                        commands: root.done ? "M5 13 L10 18 L19 7" : "";
                                        fill: transparent;
                                        stroke: Theme.on-primary;
                                        stroke-width: 2.5px;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.done = !root.done;
                                            root.toggle-homework(root.lesson.hw-key, root.done);
                                        }
                                    }
                                }
                                Text {
                                    text: "Выполнено";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.on-surface-variant;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Монохромная векторная иконка: контурная (stroke) когда неактивна,
// залитая (fill) когда активна. Один пак, стиль Material Symbols.
// id: 0 — дневник (календарь), 1 — оценки (столбцы), 2 — профиль (человек)
component NavIcon inherits Rectangle {
    in property <int> id;
    in property <bool> selected;
    in property <color> tint;

    property <string> cmd-outline:
        root.id == 0 ? "M5 6 a2 2 0 0 1 2 -2 h10 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 h-10 a2 2 0 0 1 -2 -2 z M5 9 h14 M9 3 v3 M15 3 v3"
      : root.id == 1 ? "M4 21 h16 M6 21 v-6 M12 21 v-12 M18 21 v-9"
      :                "M12 12 a4 4 0 1 0 0 -8 a4 4 0 1 0 0 8 z M5 21 a7 7 0 0 1 14 0";

    property <string> cmd-fill:
        root.id == 0 ? "M6 4 h12 a2 2 0 0 1 2 2 v12 a2 2 0 0 1 -2 2 h-12 a2 2 0 0 1 -2 -2 v-12 a2 2 0 0 1 2 -2 z M8 2 v3 M16 2 v3"
      : root.id == 1 ? "M5 13 h3 v7 h-3 z M10.5 8 h3 v12 h-3 z M16 11 h3 v9 h-3 z"
      :                "M12 12 a4 4 0 1 0 0 -8 a4 4 0 1 0 0 8 z M4 21 a8 8 0 0 1 16 0 z";

    Path {
        width: 24px; height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.selected ? root.cmd-fill : root.cmd-outline;
        fill: root.selected ? root.tint : transparent;
        stroke: root.selected ? transparent : root.tint;
        stroke-width: 1.8px;
    }
}

component NavItem inherits Rectangle {
    in property <int> icon-id;
    in property <string> label;
    in property <bool> selected;
    in property <bool> wide: false;   // раскрытый drawer: иконка и текст в строке
    callback clicked();

    // Компактный rail: иконка в пилюле (56×32), под ней label-medium
    if !root.wide : VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            // Таблетка-подложка активного таба (M3 active indicator)
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.selected ? Theme.active-container : transparent;
                animate background { duration: 150ms; }
                NavIcon {
                    width: 100%; height: 100%;
                    id: root.icon-id;
                    selected: root.selected;
                    tint: root.selected ? Theme.on-active-container : Theme.on-surface-variant;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            horizontal-alignment: center;
            color: root.selected ? Theme.on-surface : Theme.on-surface-variant;
            font-weight: root.selected ? 700 : 500;
        }
    }

    // Раскрытый drawer: пилюля с иконкой + текст на одной строке
    if root.wide : HorizontalLayout {
        alignment: start;
        padding-left: 8px;
        padding-right: 12px;
        spacing: 14px;

        Rectangle {
            width: 56px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: root.selected ? Theme.active-container : transparent;
            animate background { duration: 150ms; }
            NavIcon {
                width: 100%; height: 100%;
                id: root.icon-id;
                selected: root.selected;
                tint: root.selected ? Theme.on-active-container : Theme.on-surface-variant;
            }
        }
        Text {
            text: root.label;
            font-size: 14px;
            vertical-alignment: center;
            color: root.selected ? Theme.on-surface : Theme.on-surface-variant;
            font-weight: root.selected ? 700 : 500;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}


component LoginScreen inherits Rectangle {
    in property <string> login-error;
    in property <bool> logging-in;
    callback login-requested();
    callback demo-requested();
    background: Theme.background;
    clip: true;

    Rectangle {
        width: 460px;
        height: 460px;
        x: root.width - 250px;
        y: -170px;
        Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0; viewbox-y: 0;

import { Theme } from "../theme.slint";
import { SubjectToggle } from "../types.slint";
import { MaterialButton, MSwitch } from "../components/buttons.slint";

export component SubjectsOverlay inherits Rectangle {
    in property <[SubjectToggle]> items;
    callback toggle-subject-hidden(string, bool);
    callback close();

    background: #00000088;

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(root.width - 32px, 380px);
        height: min(subj-card.preferred-height, root.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xl;
        background: Theme.surface-container;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        subj-card := VerticalLayout {
            padding: 20px;
            spacing: 14px;

            HorizontalLayout {
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Предметы в дневнике";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: "Выключенные не показываются в дне";
                        font-size: 12px;
                        color: Theme.on-surface-variant;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: subj-close-ta.pressed ? Theme.secondary-container : transparent;
                        Path {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M6 6 L18 18 M6 18 L18 6";
                            fill: transparent;
                            stroke: Theme.on-surface-variant;
                            stroke-width: 2px;
                        }
                        subj-close-ta := TouchArea {
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.outline-variant; }

            if root.items.length == 0 : Text {
                text: "Предметы появятся после загрузки дневника";
                font-size: 13px;
                color: Theme.on-surface-variant;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            if root.items.length > 0 : Flickable {
                viewport-height: subj-list.preferred-height;
                preferred-height: min(subj-list.preferred-height, 360px);
                max-height: 360px;

                subj-list := VerticalLayout {
                    spacing: 4px;
                    padding-bottom: 4px;

                    for item in root.items : Rectangle {
                        height: 52px;
                        border-radius: Theme.radius-m;
                        background: Theme.surface-container-high;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            Text {
                                horizontal-stretch: 1;
                                text: item.subject;
                                font-size: 14px;
                                font-weight: 500;
                                color: item.hidden ? Theme.on-surface-variant : Theme.on-surface;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                            }

                            VerticalLayout {
                                alignment: center;
                                MSwitch {
                                    // Тумблер включён = предмет ВИДЕН
                                    checked: !item.hidden;
                                    toggled(on) => {
                                        root.toggle-subject-hidden(item.subject, !on);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                MaterialButton {
                    text: "Готово";
                    filled: false;
                    clicked => { root.close(); }
                }
            }
        }
    }
}



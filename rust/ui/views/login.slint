import { Theme } from "../theme.slint";
import { Md3LoadingIndicator } from "../components/loading.slint";
import { MaterialButton } from "../components/buttons.slint";

export component LoginScreen inherits Rectangle {
    in property <string> login-error;
    in property <bool> logging-in;
    callback login-requested();
    callback demo-requested();
    background: Theme.background;
    clip: true;


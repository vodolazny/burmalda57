import { Theme } from "../theme.slint";
import { ChildItem } from "../types.slint";
import { MaterialButton } from "../components/buttons.slint";
import { ChildItemCard } from "../components/cards.slint";

export component ChildSelectOverlay inherits Rectangle {
    in property <[ChildItem]> items;
    in property <bool> is-login: false;
    callback select-child(string);
    callback close();

    background: #00000088;

    TouchArea {
        clicked => {
            if (!root.is-login) {
                root.close();
            }
        }
    }

    Rectangle {
        width: min(root.width - 32px, 380px);
        height: min(card-content.preferred-height, root.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-xl;
        background: Theme.surface-container;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        card-content := VerticalLayout {
            padding: 20px;
            spacing: 14px;

            HorizontalLayout {
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "Выберите ребёнка";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: "Дневник и оценки выбранного ученика";
                        font-size: 12px;
                        color: Theme.on-surface-variant;
                    }
                }

                if !root.is-login : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: close-ta.pressed ? Theme.secondary-container : transparent;
                        Path {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M6 6 L18 18 M6 18 L18 6";
                            fill: transparent;
                            stroke: Theme.on-surface-variant;
                            stroke-width: 2px;
                        }
                        close-ta := TouchArea {
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.outline-variant; }

            Flickable {
                viewport-height: children-list.preferred-height;
                preferred-height: min(children-list.preferred-height, 300px);
                max-height: 300px;

                children-list := VerticalLayout {
                    spacing: 8px;
                    padding-bottom: 4px;

                    for item in root.items : ChildItemCard {
                        name: item.name;
                        school-class: item.school-class;
                        school-name: item.school-name;
                        selected: item.selected;
                        clicked => {
                            root.select-child(item.guid);
                        }
                    }
                }
            }

            if !root.is-login : HorizontalLayout {
                alignment: end;
                MaterialButton {
                    text: "Отмена";
                    filled: false;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

